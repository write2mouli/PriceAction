//@version=5
// ES PA Pivots SIMPLE - graded pivots + leg detection
// ============================================================================
// Same logic as before, but all global := mutations are now at top-level
// script scope (Pine v5 forbids `var_name := ...` inside `=>` functions for
// any variable declared outside the function). Functions are reduced to
// pure helpers: color/style decisions, label creation, and array-only work
// that does NOT touch the global state machine variables.
//
// Leg detection:
//   EXTEND     -- pivot extends the current leg's extreme. GREEN (up) / RED (down).
//   IN_RANGE   -- pivot stays in [anchor, extreme]. GRAY.
//   TRANSITION -- pivot breaks anchor by >= leg_break_atr*ATR. BLACK on this
//                 pivot AND retroactively on the prior leg's extreme.
//   INIT       -- pre-direction.
//
// Multi-strength grading: every pivot starts at Grade C (smallest fractal),
// upgraded to B / A if a wider fractal fires for the same bar.
// ============================================================================

indicator("ES PA Pivots Simple", overlay=true, max_labels_count=500)

// Inputs ---------------------------------------------------------------------
strength_c = input.int(1, "Grade C strength (bars each side)", minval=1, maxval=10, group="Pivot grades")
strength_b = input.int(3, "Grade B strength", minval=2, maxval=20, group="Pivot grades")
strength_a = input.int(5, "Grade A strength", minval=3, maxval=30, group="Pivot grades")

show_grade_a = input.bool(true,  "Show Grade A (major)",  group="Display")
show_grade_b = input.bool(true,  "Show Grade B (medium)", group="Display")
show_grade_c = input.bool(true,  "Show Grade C (minor)",  group="Display")
show_labels  = input.bool(true,  "Show HH/HL/LH/LL text labels", group="Display")
show_ema     = input.bool(true,  "Show EMA21", group="Display")

leg_break_atr = input.float(0.5, "Leg break threshold (xATR)", minval=0.0, maxval=3.0, step=0.05, group="Legs")
use_leg_color = input.bool(true, "Color pivots by leg state (instead of HH/HL/LH/LL)", group="Legs")

// EMA + ATR ------------------------------------------------------------------
atr14 = ta.atr(14)
ema21 = ta.ema(close, 21)
plot(show_ema ? ema21 : na, "EMA21", color=color.blue, linewidth=1)

// Multi-strength pivot detection --------------------------------------------
ph_c_val = ta.pivothigh(high, strength_c, strength_c)
ph_b_val = ta.pivothigh(high, strength_b, strength_b)
ph_a_val = ta.pivothigh(high, strength_a, strength_a)
pl_c_val = ta.pivotlow(low,  strength_c, strength_c)
pl_b_val = ta.pivotlow(low,  strength_b, strength_b)
pl_a_val = ta.pivotlow(low,  strength_a, strength_a)

// Per-pivot tracking arrays --------------------------------------------------
var array<int>    piv_bars       = array.new<int>(0)
var array<float>  piv_prices     = array.new<float>(0)
var array<int>    piv_kinds      = array.new<int>(0)
var array<int>    piv_grades     = array.new<int>(0)
var array<string> piv_slabs      = array.new<string>(0)
var array<string> piv_leg_states = array.new<string>(0)
var array<label>  piv_labs       = array.new<label>(0)

// Structural & leg state globals --------------------------------------------
var float last_h_price = na
var float last_l_price = na
// Leg state machine (HL-chain for UP, LH-chain for DOWN).
//   leg_dir       : 0=INIT, 1=UP, 2=DOWN
//   last_hl_price : during UP leg, the most recent HL price (= current support
//                   to defend; a new LL below this by `thr` breaks the leg)
//   last_lh_price : during DOWN leg, the most recent LH price (= current
//                   resistance; a new HH above this by `thr` breaks the leg)
//   leg_extreme_h_idx : index in piv_* of the highest H in the current UP leg
//                       (re-tagged BLACK when leg ends)
//   leg_extreme_l_idx : same for lowest L in the current DOWN leg
var int   leg_dir          = 0
var float last_hl_price    = na
var float last_lh_price    = na
var int   leg_extreme_h_idx = -1
var int   leg_extreme_l_idx = -1
var float leg_extreme_h_price = na
var float leg_extreme_l_price = na

// Counters
var int n_hh = 0
var int n_hl = 0
var int n_lh = 0
var int n_ll = 0
var int n_q  = 0
var int n_a  = 0
var int n_b  = 0
var int n_c  = 0
var int n_legs = 0

// Pure helpers (no global mutation) -----------------------------------------
size_for_grade(grade) =>
    grade == 3 ? size.large : grade == 2 ? size.normal : size.small

show_for_grade(grade) =>
    grade == 3 ? show_grade_a : grade == 2 ? show_grade_b : show_grade_c

color_for_leg_state(leg_state) =>
    out_c = color.gray
    if leg_state == "TRANSITION"
        out_c := color.black
    else if leg_state == "EXTEND_UP"
        out_c := color.green
    else if leg_state == "EXTEND_DN"
        out_c := color.red
    out_c

color_for_slab(slab) =>
    slab == "HH" or slab == "HL" ? color.green : slab == "LH" or slab == "LL" ? color.red : color.gray

text_style_for_kind(kind) =>
    kind == 1 ? label.style_label_down : label.style_label_up

// Create a label (no global state mutation; just returns the label ref)
draw_label_for(bx, bp, kind, slab, grade, leg_state) =>
    c = use_leg_color ? color_for_leg_state(leg_state) : color_for_slab(slab)
    if show_for_grade(grade)
        sz = size_for_grade(grade)
        style = text_style_for_kind(kind)
        txt = show_labels ? slab : ""
        label.new(bx, bp, txt, color=color.new(c, 70), textcolor=c, style=style, size=sz)
    else
        label.new(bx, bp, "", color=color.new(color.gray, 100), style=label.style_none, size=size.tiny)

// Pure compute: leg state transition using HL-chain (UP) / LH-chain (DOWN).
// Mouli's rule: HL is the primary uptrend signal, LH is the primary downtrend
// signal. HHs/LLs are secondary extensions.
//
// Returns [out_state, new_dir, new_last_hl, new_last_lh, new_extreme_h_idx,
//          new_extreme_l_idx, new_extreme_h_price, new_extreme_l_price,
//          legs_inc, retro_black_idx]
//
// out_state values:
//   EXTEND_UP   -- pivot confirms or extends the current UP leg (HL or HH)
//   EXTEND_DN   -- pivot confirms or extends the current DOWN leg (LH or LL)
//   IN_RANGE    -- counter-trend warning (LH in UP, HL in DOWN, or weak break)
//   TRANSITION  -- definitive break of HL/LH chain; ends current leg
//   INIT        -- direction not yet established
compute_leg_state(price, kind, slab, pivot_idx, cur_dir, cur_last_hl, cur_last_lh, cur_extreme_h_idx, cur_extreme_l_idx, cur_extreme_h_price, cur_extreme_l_price, thr) =>
    out_state = "INIT"
    new_dir = cur_dir
    new_last_hl = cur_last_hl
    new_last_lh = cur_last_lh
    new_extreme_h_idx = cur_extreme_h_idx
    new_extreme_l_idx = cur_extreme_l_idx
    new_extreme_h_price = cur_extreme_h_price
    new_extreme_l_price = cur_extreme_l_price
    legs_inc = 0
    retro_black_idx = -1
    if cur_dir == 0
        // INIT: wait for first HL (-> UP leg) or LL (-> DOWN leg)
        if kind == -1 and slab == "HL"
            new_dir := 1
            new_last_hl := price
            new_extreme_h_price := -1.0e10
            new_extreme_l_price := price
            new_extreme_l_idx := pivot_idx
            out_state := "EXTEND_UP"
            legs_inc := 1
        else if kind == -1 and slab == "LL"
            new_dir := 2
            new_extreme_l_price := price
            new_extreme_l_idx := pivot_idx
            out_state := "EXTEND_DN"
            legs_inc := 1
        else if kind == 1 and slab == "HH"
            // HH first -- ambiguous, but lean UP since price extended
            new_dir := 1
            new_extreme_h_price := price
            new_extreme_h_idx := pivot_idx
            out_state := "EXTEND_UP"
            legs_inc := 1
        else if kind == 1 and slab == "LH"
            new_dir := 2
            new_last_lh := price
            new_extreme_h_price := price
            new_extreme_h_idx := pivot_idx
            out_state := "EXTEND_DN"
            legs_inc := 1
        else
            out_state := "INIT"
    else if cur_dir == 1
        // UP leg: track HL chain on lows; HHs extend secondarily.
        if kind == -1
            if slab == "HL"
                // Continues HL chain -- this IS the uptrend signal
                new_last_hl := price
                out_state := "EXTEND_UP"
                if price < cur_extreme_l_price or na(cur_extreme_l_price)
                    new_extreme_l_price := price
                    new_extreme_l_idx := pivot_idx
            else
                // LL in UP leg
                if na(cur_last_hl) or price >= cur_last_hl - thr
                    // Didn't break the HL chain decisively
                    out_state := "IN_RANGE"
                else
                    // Decisive break of HL support -> TRANSITION to DOWN
                    out_state := "TRANSITION"
                    retro_black_idx := cur_extreme_h_idx
                    new_dir := 2
                    new_last_hl := na
                    new_last_lh := na
                    new_extreme_h_idx := -1
                    new_extreme_h_price := na
                    new_extreme_l_idx := pivot_idx
                    new_extreme_l_price := price
                    legs_inc := 1
        else
            // HIGH pivot in UP leg
            if slab == "HH"
                // Extends the uptrend (secondary signal)
                out_state := "EXTEND_UP"
                if price > cur_extreme_h_price or na(cur_extreme_h_price)
                    new_extreme_h_price := price
                    new_extreme_h_idx := pivot_idx
            else
                // LH in UP leg -- failed continuation warning
                out_state := "IN_RANGE"
    else if cur_dir == 2
        // DOWN leg: track LH chain on highs; LLs extend secondarily.
        if kind == 1
            if slab == "LH"
                new_last_lh := price
                out_state := "EXTEND_DN"
                if price > cur_extreme_h_price or na(cur_extreme_h_price)
                    new_extreme_h_price := price
                    new_extreme_h_idx := pivot_idx
            else
                // HH in DOWN leg
                if na(cur_last_lh) or price <= cur_last_lh + thr
                    out_state := "IN_RANGE"
                else
                    out_state := "TRANSITION"
                    retro_black_idx := cur_extreme_l_idx
                    new_dir := 1
                    new_last_hl := na
                    new_last_lh := na
                    new_extreme_l_idx := -1
                    new_extreme_l_price := na
                    new_extreme_h_idx := pivot_idx
                    new_extreme_h_price := price
                    legs_inc := 1
        else
            if slab == "LL"
                out_state := "EXTEND_DN"
                if price < cur_extreme_l_price or na(cur_extreme_l_price)
                    new_extreme_l_price := price
                    new_extreme_l_idx := pivot_idx
            else
                out_state := "IN_RANGE"
    [out_state, new_dir, new_last_hl, new_last_lh, new_extreme_h_idx, new_extreme_l_idx, new_extreme_h_price, new_extreme_l_price, legs_inc, retro_black_idx]

// Array-only helper: find the latest pivot of (bar, kind) and upgrade its
// grade label. Returns [old_grade, found_idx]; counters updated at caller.
// Iterates ascending and overwrites `found` on every match so we end up with
// the LATEST matching index. (Pine v5 rejects `by -1`; descending loops are
// not supported with negative step.)
upgrade_pivot_grade(bx, kind, new_grade) =>
    n = array.size(piv_bars)
    found = -1
    old_grade = 0
    if n > 0
        for i = 0 to n - 1
            cand_bar = array.get(piv_bars, i)
            cand_kind = array.get(piv_kinds, i)
            if cand_bar == bx
                if cand_kind == kind
                    found := i
        if found >= 0
            old_grade := array.get(piv_grades, found)
            if new_grade > old_grade
                array.set(piv_grades, found, new_grade)
                old_lab = array.get(piv_labs, found)
                label.delete(old_lab)
                slab_v = array.get(piv_slabs, found)
                bp = array.get(piv_prices, found)
                leg_state_v = array.get(piv_leg_states, found)
                new_lab = draw_label_for(bx, bp, kind, slab_v, new_grade, leg_state_v)
                array.set(piv_labs, found, new_lab)
    [old_grade, found]

// Array-only helper: re-draw a pivot's label with a forced leg_state
// (used for the retroactive TRANSITION marking on prior leg extreme).
retag_label(idx, new_leg_state) =>
    if idx >= 0
        if idx < array.size(piv_labs)
            old_lab = array.get(piv_labs, idx)
            label.delete(old_lab)
            ex_bx = array.get(piv_bars, idx)
            ex_bp = array.get(piv_prices, idx)
            ex_kind = array.get(piv_kinds, idx)
            ex_grade = array.get(piv_grades, idx)
            ex_slab = array.get(piv_slabs, idx)
            new_lab = draw_label_for(ex_bx, ex_bp, ex_kind, ex_slab, ex_grade, new_leg_state)
            array.set(piv_labs, idx, new_lab)
            array.set(piv_leg_states, idx, new_leg_state)

// === Process detections this bar ===========================================
thr = na(atr14) ? 0.0 : atr14 * leg_break_atr

// --- Grade C HIGH ---
if not na(ph_c_val)
    bx = bar_index - strength_c
    bp = ph_c_val
    // Structural label
    slab = na(last_h_price) ? "?" : (bp > last_h_price ? "HH" : "LH")
    last_h_price := bp
    // Counters
    if slab == "HH"
        n_hh := n_hh + 1
    else if slab == "LH"
        n_lh := n_lh + 1
    else
        n_q := n_q + 1
    n_c := n_c + 1
    // Push pivot record
    array.push(piv_bars, bx)
    array.push(piv_prices, bp)
    array.push(piv_kinds, 1)
    array.push(piv_grades, 1)
    array.push(piv_slabs, slab)
    new_idx = array.size(piv_bars) - 1
    // Leg state compute (HL/LH chain)
    [leg_state, new_dir, new_last_hl, new_last_lh, new_eh_idx, new_el_idx, new_eh_price, new_el_price, legs_inc, retro_idx] = compute_leg_state(bp, 1, slab, new_idx, leg_dir, last_hl_price, last_lh_price, leg_extreme_h_idx, leg_extreme_l_idx, leg_extreme_h_price, leg_extreme_l_price, thr)
    leg_dir := new_dir
    last_hl_price := new_last_hl
    last_lh_price := new_last_lh
    leg_extreme_h_idx := new_eh_idx
    leg_extreme_l_idx := new_el_idx
    leg_extreme_h_price := new_eh_price
    leg_extreme_l_price := new_el_price
    n_legs := n_legs + legs_inc
    array.push(piv_leg_states, leg_state)
    if retro_idx >= 0
        retag_label(retro_idx, "TRANSITION")
    // Draw this pivot's label
    lab = draw_label_for(bx, bp, 1, slab, 1, leg_state)
    array.push(piv_labs, lab)

// --- Grade C LOW ---
if not na(pl_c_val)
    bx = bar_index - strength_c
    bp = pl_c_val
    slab = na(last_l_price) ? "?" : (bp < last_l_price ? "LL" : "HL")
    last_l_price := bp
    if slab == "HL"
        n_hl := n_hl + 1
    else if slab == "LL"
        n_ll := n_ll + 1
    else
        n_q := n_q + 1
    n_c := n_c + 1
    array.push(piv_bars, bx)
    array.push(piv_prices, bp)
    array.push(piv_kinds, -1)
    array.push(piv_grades, 1)
    array.push(piv_slabs, slab)
    new_idx = array.size(piv_bars) - 1
    [leg_state, new_dir, new_last_hl, new_last_lh, new_eh_idx, new_el_idx, new_eh_price, new_el_price, legs_inc, retro_idx] = compute_leg_state(bp, -1, slab, new_idx, leg_dir, last_hl_price, last_lh_price, leg_extreme_h_idx, leg_extreme_l_idx, leg_extreme_h_price, leg_extreme_l_price, thr)
    leg_dir := new_dir
    last_hl_price := new_last_hl
    last_lh_price := new_last_lh
    leg_extreme_h_idx := new_eh_idx
    leg_extreme_l_idx := new_el_idx
    leg_extreme_h_price := new_eh_price
    leg_extreme_l_price := new_el_price
    n_legs := n_legs + legs_inc
    array.push(piv_leg_states, leg_state)
    if retro_idx >= 0
        retag_label(retro_idx, "TRANSITION")
    lab = draw_label_for(bx, bp, -1, slab, 1, leg_state)
    array.push(piv_labs, lab)

// --- Grade B upgrades ---
if not na(ph_b_val)
    [old_g, found_idx] = upgrade_pivot_grade(bar_index - strength_b, 1, 2)
    if found_idx >= 0
        if old_g < 2
            n_b := n_b + 1
            if old_g == 1
                n_c := n_c - 1
if not na(pl_b_val)
    [old_g, found_idx] = upgrade_pivot_grade(bar_index - strength_b, -1, 2)
    if found_idx >= 0
        if old_g < 2
            n_b := n_b + 1
            if old_g == 1
                n_c := n_c - 1

// --- Grade A upgrades ---
if not na(ph_a_val)
    [old_g, found_idx] = upgrade_pivot_grade(bar_index - strength_a, 1, 3)
    if found_idx >= 0
        if old_g < 3
            n_a := n_a + 1
            if old_g == 1
                n_c := n_c - 1
            else if old_g == 2
                n_b := n_b - 1
if not na(pl_a_val)
    [old_g, found_idx] = upgrade_pivot_grade(bar_index - strength_a, -1, 3)
    if found_idx >= 0
        if old_g < 3
            n_a := n_a + 1
            if old_g == 1
                n_c := n_c - 1
            else if old_g == 2
                n_b := n_b - 1

// Status table ---------------------------------------------------------------
var table tbl = table.new(position.top_right, 2, 10, bgcolor=color.new(color.gray, 80), border_width=1)
if barstate.islast
    leg_dir_s = leg_dir == 0 ? "INIT" : leg_dir == 1 ? "UP" : "DOWN"
    table.cell(tbl, 0, 0, "Leg dir", text_color=color.black, text_size=size.normal)
    table.cell(tbl, 1, 0, leg_dir_s, text_color=color.black, text_size=size.normal)
    table.cell(tbl, 0, 1, "Legs",    text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(n_legs), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 2, "Grade A", text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(n_a), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 3, "Grade B", text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(n_b), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 4, "Grade C", text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(n_c), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 5, "HH", text_color=color.green, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(n_hh), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 6, "HL", text_color=color.green, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(n_hl), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 7, "LH", text_color=color.red,   text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(n_lh), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 8, "LL", text_color=color.red,   text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(n_ll), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 9, "?",  text_color=color.gray,  text_size=size.small)
    table.cell(tbl, 1, 9, str.tostring(n_q),  text_color=color.black, text_size=size.small)
