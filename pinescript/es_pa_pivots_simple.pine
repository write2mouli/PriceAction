//@version=5
// ES PA Pivots SIMPLE - graded pivots + leg detection
// ============================================================================
// Same logic as before, but all global := mutations are now at top-level
// script scope (Pine v5 forbids `var_name := ...` inside `=>` functions for
// any variable declared outside the function). Functions are reduced to
// pure helpers: color/style decisions, label creation, and array-only work
// that does NOT touch the global state machine variables.
//
// Leg detection:
//   EXTEND     -- pivot extends the current leg's extreme. GREEN (up) / RED (down).
//   IN_RANGE   -- pivot stays in [anchor, extreme]. GRAY.
//   TRANSITION -- pivot breaks anchor by >= leg_break_atr*ATR. BLACK on this
//                 pivot AND retroactively on the prior leg's extreme.
//   INIT       -- pre-direction.
//
// Multi-strength grading: every pivot starts at Grade C (smallest fractal),
// upgraded to B / A if a wider fractal fires for the same bar.
// ============================================================================

indicator("ES PA Pivots Simple", overlay=true, max_labels_count=500, max_lines_count=500)

// Inputs ---------------------------------------------------------------------
strength_c = input.int(1, "Grade C strength (bars each side)", minval=1, maxval=10, group="Pivot grades")
strength_b = input.int(3, "Grade B strength", minval=2, maxval=20, group="Pivot grades")
strength_a = input.int(5, "Grade A strength", minval=3, maxval=30, group="Pivot grades")

show_pivots  = input.bool(false, "Show pivot markers", group="Display")
show_grade_a = input.bool(true,  "Show Grade A (major)",  group="Display")
show_grade_b = input.bool(true,  "Show Grade B (medium)", group="Display")
show_grade_c = input.bool(true,  "Show Grade C (minor)",  group="Display")
show_labels  = input.bool(false, "Show HH/HL/LH/LL text labels", group="Display")
show_ema     = input.bool(true,  "Show EMA21", group="Display")

leg_break_atr = input.float(0.75, "Leg break threshold (xATR)", minval=0.0, maxval=3.0, step=0.05, tooltip="Raised from 0.5: minor wiggles inside a range no longer spawn micro-legs.", group="Legs")
use_leg_color = input.bool(true, "Color pivots by leg state (instead of HH/HL/LH/LL)", group="Legs")

show_channels  = input.bool(true, "Draw parallel channel per leg", group="Channels")
channel_min_pivots = input.int(2, "Min HL/LH pivots to start drawing", minval=2, maxval=10, tooltip="Need at least this many HLs (UP) or LHs (DOWN) before the channel appears. 2 = draw as soon as the slope can be defined.", group="Channels")
channel_extend = input.bool(true, "Extend channel lines to the right", group="Channels")
channel_touch_atr = input.float(0.4, "Touch tolerance (xATR)", minval=0.05, maxval=2.0, step=0.05, tooltip="A pivot counts as a touch of the parallel if it's within this distance of the line. Used for the solid-channel test.", group="Channels")
channel_solid_extreme_touches = input.int(1, "Solid: min extreme-side touches", minval=1, maxval=5, tooltip="Channel becomes 'solid' (thicker lines) when there are this many HH/LL pivots near the parallel.", group="Channels")
broad_small_atr = input.float(2.0, "Range merge: max channel height (xATR) for a 'slim' leg", minval=0.5, maxval=10.0, step=0.25, tooltip="A finalized channel whose height (chain-to-parallel distance) is <= this many ATRs counts as a slim/range leg. Trading-range legs are thin in PRICE even when wide in time, so we measure amplitude, not bar count.", group="Channels")
broad_min_run = input.int(3, "Range merge: consecutive small legs to merge", minval=2, maxval=10, tooltip="When this many small legs occur back-to-back (a trading range), their slim channels are replaced by ONE broad parallel band.", group="Channels")

// Major-scale channel layer (cyan). A SECOND leg machine fed only Grade-A
// (major-swing) pivots with a larger break threshold, so minor wiggles don't
// fragment it. The result is a handful of big trend channels overlaid on the
// minor green/red ones -- the steep impulse and the broad grind each as ONE.
show_major = input.bool(true, "Draw major-scale channels (cyan)", group="Major channels")
major_min_grade = input.int(3, "Major: min pivot grade for channel touches (3=A, 2=B+)", minval=2, maxval=3, tooltip="Leg structure is always defined by Grade-A swings; this controls which pivots the channel regression rides. 3 (A only) matches the validated Python prototype -- cleaner. 2 (B+) adds more touch points if the channels look too sparse.", group="Major channels")
major_break_atr = input.float(1.5, "Major: break threshold (xATR)", minval=0.25, maxval=5.0, step=0.25, tooltip="Higher = fewer, broader major legs. A major leg only reverses when a Grade-A pivot breaks its HL/LH chain by this many ATRs. Raise it if the midday grind splits into several channels instead of one.", group="Major channels")
major_width = input.int(3, "Major: line width (px)", minval=1, maxval=6, group="Major channels")
major_fit_atr = input.float(1.2, "Major: regression fit tolerance (xATR)", minval=0.25, maxval=5.0, step=0.1, tooltip="Piecewise regression (spike-and-channel). The major channel slope is the least-squares regression over the segment's support pivots, recomputed each pivot so it DEVELOPS as time progresses. When a new pivot makes that regression stop fitting -- max residual of the support pivots exceeds this many ATRs -- the segment is finalized and a fresh regression starts at the prior pivot (a genuine slope change like spike->grind). Larger = fewer, longer channels.", group="Major channels")
major_break_margin_atr = input.float(0.25, "Major: clean-break margin (xATR)", minval=0.0, maxval=2.0, step=0.05, tooltip="A channel ends only when a bar CLOSES beyond its trend-side line (support for UP / resistance for DOWN) by at least this many ATRs -- a CLEAN break, not a marginal poke. Raise it if downtrends fragment into many short channels because normal bounces nick the resistance.", group="Major channels")

// EMA + ATR ------------------------------------------------------------------
atr14 = ta.atr(14)
ema21 = ta.ema(close, 21)
plot(show_ema ? ema21 : na, "EMA21", color=color.blue, linewidth=1)

// Multi-strength pivot detection --------------------------------------------
ph_c_val = ta.pivothigh(high, strength_c, strength_c)
ph_b_val = ta.pivothigh(high, strength_b, strength_b)
ph_a_val = ta.pivothigh(high, strength_a, strength_a)
pl_c_val = ta.pivotlow(low,  strength_c, strength_c)
pl_b_val = ta.pivotlow(low,  strength_b, strength_b)
pl_a_val = ta.pivotlow(low,  strength_a, strength_a)

// Per-pivot tracking arrays --------------------------------------------------
var array<int>    piv_bars       = array.new<int>(0)
var array<float>  piv_prices     = array.new<float>(0)
var array<int>    piv_kinds      = array.new<int>(0)
var array<int>    piv_grades     = array.new<int>(0)
var array<string> piv_slabs      = array.new<string>(0)
var array<string> piv_leg_states = array.new<string>(0)
var array<label>  piv_labs       = array.new<label>(0)

// Structural & leg state globals --------------------------------------------
var float last_h_price = na
var float last_l_price = na
// Leg state machine (HL-chain for UP, LH-chain for DOWN).
//   leg_dir       : 0=INIT, 1=UP, 2=DOWN
//   last_hl_price : during UP leg, the most recent HL price (= current support
//                   to defend; a new LL below this by `thr` breaks the leg)
//   last_lh_price : during DOWN leg, the most recent LH price (= current
//                   resistance; a new HH above this by `thr` breaks the leg)
//   leg_extreme_h_idx : index in piv_* of the highest H in the current UP leg
//                       (re-tagged BLACK when leg ends)
//   leg_extreme_l_idx : same for lowest L in the current DOWN leg
var int   leg_dir          = 0
var float last_hl_price    = na
var float last_lh_price    = na
var int   leg_extreme_h_idx = -1
var int   leg_extreme_l_idx = -1
var float leg_extreme_h_price = na
var float leg_extreme_l_price = na

// Index in piv_* arrays of the pivot that started the CURRENT leg.
var int   leg_start_pivot_idx = -1

// Adaptive channel: lines being LIVE-updated during the current epoch.
// On CHoCH (Change of Character = any LL in UP or HH in DOWN) or TRANSITION,
// the prior epoch's lines are DELETED and new lines start fresh. Old
// channels don't accumulate on the chart -- only the active channel for
// the current epoch is shown.
var line  cur_leg_trendline = na    // chain line: support (UP, rides LLâ†’HLs) / resistance (DOWN, rides HHâ†’LHs)
var line  cur_leg_parallel  = na    // opposite parallel through first opposite-side pivot
var line  cur_leg_center    = na    // center / median line midway between the two

// Channel epoch start = pivot index where the CURRENT channel began.
// Resets on CHoCH (Mouli: "as soon as character changes -- HL breached
// and LL formed") or TRANSITION (full leg reversal). The epoch may start
// mid-leg if the HL chain breaks even by a small amount.
var int   channel_epoch_start_idx = -1

// --- Major-scale leg machine state (mirror of the minor one, fed only Grade-A
// pivots through the same pure compute_leg_state). Independent so the two
// scales never interfere. m_chain/m_par/m_cen are the LIVE major channel; on a
// major transition they're finalized (clipped + kept) and new lines start.
var int   m_leg_dir   = 0
var float m_last_hl   = na
var float m_last_lh   = na
var int   m_eh_idx    = -1
var int   m_el_idx    = -1
var float m_eh_price  = na
var float m_el_price  = na
var line  m_chain = na
var line  m_par   = na
var line  m_cen   = na
// Piecewise regression: the current channel SEGMENT (one regression phase within
// the leg). Its slope is the regression over the segment's support pivots,
// recomputed each pivot. When that regression stops fitting, the segment is
// finalized and a new one starts at the prior pivot.
var int   m_seg_start_idx = -1

// Counters
var int n_hh = 0
var int n_hl = 0
var int n_lh = 0
var int n_ll = 0
var int n_q  = 0
var int n_a  = 0
var int n_b  = 0
var int n_c  = 0
var int n_legs = 0
// Diagnostic: count how many times we've actually drawn a channel line
var int n_channel_draws = 0
// Diagnostic: last n_chain value seen by update_current_channel
var int last_n_chain = 0

// Pure helpers (no global mutation) -----------------------------------------
size_for_grade(grade) =>
    grade == 3 ? size.large : grade == 2 ? size.normal : size.small

show_for_grade(grade) =>
    grade == 3 ? show_grade_a : grade == 2 ? show_grade_b : show_grade_c

color_for_leg_state(leg_state) =>
    out_c = color.gray
    if leg_state == "TRANSITION"
        out_c := color.black
    else if leg_state == "EXTEND_UP"
        out_c := color.green
    else if leg_state == "EXTEND_DN"
        out_c := color.red
    out_c

color_for_slab(slab) =>
    slab == "HH" or slab == "HL" ? color.green : slab == "LH" or slab == "LL" ? color.red : color.gray

text_style_for_kind(kind) =>
    kind == 1 ? label.style_label_down : label.style_label_up

// Create a label (no global state mutation; just returns the label ref)
draw_label_for(bx, bp, kind, slab, grade, leg_state) =>
    c = use_leg_color ? color_for_leg_state(leg_state) : color_for_slab(slab)
    if show_pivots and show_for_grade(grade)
        sz = size_for_grade(grade)
        style = text_style_for_kind(kind)
        txt = show_labels ? slab : ""
        label.new(bx, bp, txt, color=color.new(c, 70), textcolor=c, style=style, size=sz)
    else
        label.new(bx, bp, "", color=color.new(color.gray, 100), style=label.style_none, size=size.tiny)

// Pure compute: leg state transition using HL-chain (UP) / LH-chain (DOWN).
// Mouli's rule: HL is the primary uptrend signal, LH is the primary downtrend
// signal. HHs/LLs are secondary extensions.
//
// Returns [out_state, new_dir, new_last_hl, new_last_lh, new_extreme_h_idx,
//          new_extreme_l_idx, new_extreme_h_price, new_extreme_l_price,
//          legs_inc, retro_black_idx]
//
// out_state values:
//   EXTEND_UP   -- pivot confirms or extends the current UP leg (HL or HH)
//   EXTEND_DN   -- pivot confirms or extends the current DOWN leg (LH or LL)
//   IN_RANGE    -- counter-trend warning (LH in UP, HL in DOWN, or weak break)
//   TRANSITION  -- definitive break of HL/LH chain; ends current leg
//   INIT        -- direction not yet established
compute_leg_state(price, kind, slab, pivot_idx, cur_dir, cur_last_hl, cur_last_lh, cur_extreme_h_idx, cur_extreme_l_idx, cur_extreme_h_price, cur_extreme_l_price, thr) =>
    out_state = "INIT"
    new_dir = cur_dir
    new_last_hl = cur_last_hl
    new_last_lh = cur_last_lh
    new_extreme_h_idx = cur_extreme_h_idx
    new_extreme_l_idx = cur_extreme_l_idx
    new_extreme_h_price = cur_extreme_h_price
    new_extreme_l_price = cur_extreme_l_price
    legs_inc = 0
    retro_black_idx = -1
    if cur_dir == 0
        // INIT: wait for first HL (-> UP leg) or LL (-> DOWN leg)
        if kind == -1 and slab == "HL"
            new_dir := 1
            new_last_hl := price
            new_extreme_h_price := -1.0e10
            new_extreme_l_price := price
            new_extreme_l_idx := pivot_idx
            out_state := "EXTEND_UP"
            legs_inc := 1
        else if kind == -1 and slab == "LL"
            new_dir := 2
            new_extreme_l_price := price
            new_extreme_l_idx := pivot_idx
            out_state := "EXTEND_DN"
            legs_inc := 1
        else if kind == 1 and slab == "HH"
            // HH first -- ambiguous, but lean UP since price extended
            new_dir := 1
            new_extreme_h_price := price
            new_extreme_h_idx := pivot_idx
            out_state := "EXTEND_UP"
            legs_inc := 1
        else if kind == 1 and slab == "LH"
            new_dir := 2
            new_last_lh := price
            new_extreme_h_price := price
            new_extreme_h_idx := pivot_idx
            out_state := "EXTEND_DN"
            legs_inc := 1
        else
            out_state := "INIT"
    else if cur_dir == 1
        // UP leg: track HL chain on lows; HHs extend secondarily.
        if kind == -1
            if slab == "HL"
                // Continues HL chain -- this IS the uptrend signal
                new_last_hl := price
                out_state := "EXTEND_UP"
                if price < cur_extreme_l_price or na(cur_extreme_l_price)
                    new_extreme_l_price := price
                    new_extreme_l_idx := pivot_idx
            else
                // LL in UP leg
                if na(cur_last_hl) or price >= cur_last_hl - thr
                    // Didn't break the HL chain decisively
                    out_state := "IN_RANGE"
                else
                    // Decisive break of HL support -> TRANSITION to DOWN
                    out_state := "TRANSITION"
                    retro_black_idx := cur_extreme_h_idx
                    new_dir := 2
                    new_last_hl := na
                    new_last_lh := na
                    new_extreme_h_idx := -1
                    new_extreme_h_price := na
                    new_extreme_l_idx := pivot_idx
                    new_extreme_l_price := price
                    legs_inc := 1
        else
            // HIGH pivot in UP leg
            if slab == "HH"
                // Extends the uptrend (secondary signal)
                out_state := "EXTEND_UP"
                if price > cur_extreme_h_price or na(cur_extreme_h_price)
                    new_extreme_h_price := price
                    new_extreme_h_idx := pivot_idx
            else
                // LH in UP leg -- failed continuation warning
                out_state := "IN_RANGE"
    else if cur_dir == 2
        // DOWN leg: track LH chain on highs; LLs extend secondarily.
        if kind == 1
            if slab == "LH"
                new_last_lh := price
                out_state := "EXTEND_DN"
                if price > cur_extreme_h_price or na(cur_extreme_h_price)
                    new_extreme_h_price := price
                    new_extreme_h_idx := pivot_idx
            else
                // HH in DOWN leg
                if na(cur_last_lh) or price <= cur_last_lh + thr
                    out_state := "IN_RANGE"
                else
                    out_state := "TRANSITION"
                    retro_black_idx := cur_extreme_l_idx
                    new_dir := 1
                    new_last_hl := na
                    new_last_lh := na
                    new_extreme_l_idx := -1
                    new_extreme_l_price := na
                    new_extreme_h_idx := pivot_idx
                    new_extreme_h_price := price
                    legs_inc := 1
        else
            if slab == "LL"
                out_state := "EXTEND_DN"
                if price < cur_extreme_l_price or na(cur_extreme_l_price)
                    new_extreme_l_price := price
                    new_extreme_l_idx := pivot_idx
            else
                out_state := "IN_RANGE"
    [out_state, new_dir, new_last_hl, new_last_lh, new_extreme_h_idx, new_extreme_l_idx, new_extreme_h_price, new_extreme_l_price, legs_inc, retro_black_idx]

// Find the price of the most recent same-kind pivot with grade >= min_grade
// that exists BEFORE the given pivot index. Returns na if none exists.
// Ascending loop overwrites on each match, so final value is the latest.
find_prev_significant_price(pivot_idx, kind, min_grade) =>
    float result = na
    if pivot_idx > 0
        for i = 0 to pivot_idx - 1
            cand_kind = array.get(piv_kinds, i)
            cand_grade = array.get(piv_grades, i)
            if cand_kind == kind
                if cand_grade >= min_grade
                    result := array.get(piv_prices, i)
    result

// Array-only helper: find the latest pivot of (bar, kind) and upgrade its
// grade label. Returns [old_grade, found_idx, old_slab, new_slab];
// counters updated at caller (so we can correct HH/HL/LH/LL counts when
// the slab flips on re-classification).
//
// When upgrading to grade >= 2, the slab is RE-CLASSIFIED against the
// previous same-kind Grade B+ pivot, not the immediate prior fractal --
// this fixes Mouli's complaint that large icons get marked LL when a
// noisy intermediate low sat higher in between.
upgrade_pivot_grade(bx, kind, new_grade) =>
    n = array.size(piv_bars)
    found = -1
    old_grade = 0
    old_slab = ""
    new_slab = ""
    if n > 0
        for i = 0 to n - 1
            cand_bar = array.get(piv_bars, i)
            cand_kind = array.get(piv_kinds, i)
            if cand_bar == bx
                if cand_kind == kind
                    found := i
        if found >= 0
            old_grade := array.get(piv_grades, found)
            old_slab := array.get(piv_slabs, found)
            new_slab := old_slab
            if new_grade > old_grade
                array.set(piv_grades, found, new_grade)
                bp = array.get(piv_prices, found)
                // Re-classify slab against the previous same-kind pivot whose
                // grade is at least new_grade (a "swing" of equivalent weight).
                ref_price = find_prev_significant_price(found, kind, new_grade)
                if not na(ref_price)
                    if kind == 1
                        new_slab := bp > ref_price ? "HH" : "LH"
                    else
                        new_slab := bp < ref_price ? "LL" : "HL"
                array.set(piv_slabs, found, new_slab)
                old_lab = array.get(piv_labs, found)
                label.delete(old_lab)
                leg_state_v = array.get(piv_leg_states, found)
                new_lab = draw_label_for(bx, bp, kind, new_slab, new_grade, leg_state_v)
                array.set(piv_labs, found, new_lab)
    [old_grade, found, old_slab, new_slab]

// Finalize a completed leg's channel line: clip its right edge to clip_x
// (the transition bar) and stop it extending to the right. This keeps the
// channel ON the chart as a bounded parallelogram over the leg's lifespan
// -- matching how Mouli hand-draws one channel per leg -- instead of
// deleting it (which left the chart with at most one live channel, often
// none at the right edge) or letting it project forward forever (clutter).
// Line setters don't mutate script globals, so this is fine inside a fn.
finalize_channel(ln, clip_x) =>
    if not na(ln)
        x1 = line.get_x1(ln)
        y1 = line.get_y1(ln)
        x2 = line.get_x2(ln)
        y2 = line.get_y2(ln)
        if x2 != x1
            sl = (y2 - y1) / (x2 - x1)
            line.set_xy2(ln, clip_x, y1 + sl * (clip_x - x1))
        line.set_extend(ln, extend.none)

// Registry of finalized (completed) channels, used to dedup overlaps. We keep
// the three line refs plus each channel's bar range [xa, xb].
var array<line> fin_chain = array.new<line>(0)
var array<line> fin_par   = array.new<line>(0)
var array<line> fin_cen   = array.new<line>(0)
var array<int>  fin_xa    = array.new<int>(0)
var array<int>  fin_xb    = array.new<int>(0)

// Broad trading-range channel state. When several small legs occur back to
// back (a range), their slim channels are suppressed and replaced by ONE broad
// parallel band drawn with draw_broad. The run buffer holds the slim line refs
// so they can be deleted once the run is confirmed.
var array<line> run_chain   = array.new<line>(0)
var array<line> run_par     = array.new<line>(0)
var array<line> run_cen     = array.new<line>(0)
var int  run_count          = 0
var int  run_start_idx      = -1
var line broad_chain        = na
var line broad_par          = na
var line broad_cen          = na

// Draw a broad parallel band over pivots [s_idx, e_idx]: one regression slope
// over ALL pivots, top line offset through the highest high, bottom through the
// lowest low, center between. Distinct purple color flags it as a range.
draw_broad(s_idx, e_idx, right_x) =>
    line bc = na
    line bp = na
    line bn = na
    if s_idx >= 0 and e_idx >= s_idx and e_idx < array.size(piv_bars)
        int   cnt = 0
        float sx  = 0.0
        float sy  = 0.0
        float sxy = 0.0
        float sxx = 0.0
        float hi_p = -1.0e18
        float lo_p =  1.0e18
        int   hi_bar = 0
        int   lo_bar = 0
        for i = s_idx to e_idx
            b = array.get(piv_bars, i)
            p = array.get(piv_prices, i)
            cnt := cnt + 1
            sx  := sx + b
            sy  := sy + p
            sxy := sxy + b * p
            sxx := sxx + b * b
            if p > hi_p
                hi_p := p
                hi_bar := b
            if p < lo_p
                lo_p := p
                lo_bar := b
        den = cnt * sxx - sx * sx
        if cnt >= 3
            slope = den != 0 ? (cnt * sxy - sx * sy) / den : 0.0
            x_left = array.get(piv_bars, s_idx)
            top_b = hi_p - slope * hi_bar
            bot_b = lo_p - slope * lo_bar
            top_yL = top_b + slope * x_left
            top_yR = top_b + slope * right_x
            bot_yL = bot_b + slope * x_left
            bot_yR = bot_b + slope * right_x
            cen_yL = (top_yL + bot_yL) / 2.0
            cen_yR = (top_yR + bot_yR) / 2.0
            colb = color.purple
            // A broad band marks a COMPLETED trading range, so it must NOT
            // project to the right -- that produced the "channel extending even
            // after the break" overlap. It always spans only [range start ..
            // last slim transition] and is redrawn longer as the range extends.
            bc := line.new(x_left, top_yL, right_x, top_yR, color=colb, width=2, extend=extend.none)
            bp := line.new(x_left, bot_yL, right_x, bot_yR, color=colb, width=2, extend=extend.none)
            bn := line.new(x_left, cen_yL, right_x, cen_yR, color=color.new(colb, 35), width=1, style=line.style_dotted, extend=extend.none)
    [bc, bp, bn]

// Engulf-dedup a finalized (large) channel against existing finalized channels.
// Conservative: when one channel's bar range is fully CONTAINED in another whose
// span is >= 2x larger, keep only the bigger one. Abutting/partial overlaps are
// both kept, so this never collapses the whole chart -- only nested duplicates.
dedup_register(chain, par, cen) =>
    if not na(chain)
        nxa = line.get_x1(chain)
        nxb = line.get_x2(chain)
        nspan = math.max(1, nxb - nxa)
        keep_new = true
        i = 0
        while i < array.size(fin_xa)
            exa = array.get(fin_xa, i)
            exb = array.get(fin_xb, i)
            espan = math.max(1, exb - exa)
            new_engulfs = nxa <= exa and nxb >= exb and espan * 2 <= nspan
            old_engulfs = exa <= nxa and exb >= nxb and nspan * 2 <= espan
            if new_engulfs
                line.delete(array.get(fin_chain, i))
                line.delete(array.get(fin_par, i))
                line.delete(array.get(fin_cen, i))
                array.remove(fin_chain, i)
                array.remove(fin_par, i)
                array.remove(fin_cen, i)
                array.remove(fin_xa, i)
                array.remove(fin_xb, i)
            else
                if old_engulfs
                    keep_new := false
                i := i + 1
        if keep_new
            array.push(fin_chain, chain)
            array.push(fin_par, par)
            array.push(fin_cen, cen)
            array.push(fin_xa, nxa)
            array.push(fin_xb, nxb)
        else
            line.delete(chain)
            line.delete(par)
            line.delete(cen)

// Finalize a just-completed channel. Small legs are buffered into a run; once
// broad_min_run consecutive small legs accumulate (a range), their slim lines
// are deleted and one broad band is drawn. A large leg ends any run and is
// engulf-deduped normally.
// Pine v5 forbids `:=` on globals inside a function, so the run-state scalars
// and broad-line refs are passed in and the NEW values returned for the caller
// to assign at top level. The run_* and fin_* arrays are mutated in place
// (array.push/clear/remove are allowed inside functions).
register_finalized(chain, par, cen, clip_x, s_idx, e_idx, in_rc, in_rsi, in_bch, in_bp, in_bn) =>
    finalize_channel(chain, clip_x)
    finalize_channel(par, clip_x)
    finalize_channel(cen, clip_x)
    int  o_rc  = in_rc
    int  o_rsi = in_rsi
    line o_bch = in_bch
    line o_bp  = in_bp
    line o_bn  = in_bn
    if not na(chain) and not na(par)
        // "Slim" = small AMPLITUDE, not few bars. A trading-range leg is thin in
        // price (chain line and its parallel sit close together) yet can span
        // many bars of sideways chop. Measuring channel height in ATRs catches
        // those range legs; a bar-count test missed them (they're wide in time).
        // get_y1 is the anchor y on each line; finalize_channel only moved x2/y2,
        // so the anchor distance is still the channel's height.
        ch_height = math.abs(line.get_y1(chain) - line.get_y1(par))
        atrv = na(atr14) ? 0.0 : atr14
        is_small = atrv > 0 and ch_height <= broad_small_atr * atrv
        if is_small
            if o_rc == 0
                o_rsi := s_idx
            o_rc := o_rc + 1
            array.push(run_chain, chain)
            array.push(run_par, par)
            array.push(run_cen, cen)
            if o_rc >= broad_min_run
                // Confirmed range: drop every slim line we are holding and
                // (re)draw the broad band over the whole run so far.
                for k = 0 to array.size(run_chain) - 1
                    line.delete(array.get(run_chain, k))
                    line.delete(array.get(run_par, k))
                    line.delete(array.get(run_cen, k))
                array.clear(run_chain)
                array.clear(run_par)
                array.clear(run_cen)
                line.delete(o_bch)
                line.delete(o_bp)
                line.delete(o_bn)
                [bc, bp2, bn2] = draw_broad(o_rsi, e_idx, clip_x)
                o_bch := bc
                o_bp  := bp2
                o_bn  := bn2
        else
            // Large leg ends any open run. Leave the broad band (if any) on the
            // chart, drop our refs, reset the run, and dedup this big channel.
            o_rc  := 0
            o_rsi := -1
            array.clear(run_chain)
            array.clear(run_par)
            array.clear(run_cen)
            o_bch := na
            o_bp  := na
            o_bn  := na
            dedup_register(chain, par, cen)
    [o_rc, o_rsi, o_bch, o_bp, o_bn]

// Array-only helper: re-draw a pivot's label with a forced leg_state
// (used for the retroactive TRANSITION marking on prior leg extreme).
retag_label(idx, new_leg_state) =>
    if idx >= 0
        if idx < array.size(piv_labs)
            old_lab = array.get(piv_labs, idx)
            label.delete(old_lab)
            ex_bx = array.get(piv_bars, idx)
            ex_bp = array.get(piv_prices, idx)
            ex_kind = array.get(piv_kinds, idx)
            ex_grade = array.get(piv_grades, idx)
            ex_slab = array.get(piv_slabs, idx)
            new_lab = draw_label_for(ex_bx, ex_bp, ex_kind, ex_slab, ex_grade, new_leg_state)
            array.set(piv_labs, idx, new_lab)
            array.set(piv_leg_states, idx, new_leg_state)

// Adaptive 3-line channel update for the CURRENT leg. Called after every new
// pivot in an active leg. Pure compute -- doesn't mutate globals; caller
// re-assigns the returned line refs.
//
// Construction (inclusive regression channel, redrawn as the leg develops):
//   1. TILT: least-squares regression slope over the trend-defining (chain-side)
//      pivots -- HLs for UP, LHs for DOWN. These are the pivots Mouli's eye
//      connects, so the channel rides the trend rather than going near-vertical.
//   2. ENVELOPE: offset two parallel boundaries to the max/min residual of EVERY
//      pivot (highs and lows) from that regression line. The band therefore
//      contains all the swing pivots. When price exits in the SAME direction at a
//      future pivot, that pivot becomes the new extreme residual and the band
//      simply gets broader -- the channel stays inclusive instead of being
//      escaped. Wicks between pivots and rare anomalies may still poke out; ok.
//   3. The chain line is the trend-defining boundary (support/lows for UP,
//      resistance/highs for DOWN); the parallel is the opposite envelope; the
//      center is their midline.
//
// Recomputed every pivot, so the slope and width adapt "as time moves forward."
//
// Returns [new_chain, new_parallel, new_center, n_chain_found]
// min_grade: only pivots of this grade or higher define the hull/envelope, so
//            the MAJOR layer (min_grade>=2) rides major swings, the minor layer
//            (min_grade=1) uses every pivot.
// maj:       true -> cyan/orange thick lines drawn under show_major; false ->
//            green/red thin lines under show_channels.
// in_locked_slope: if not na, the slope is FORCED to this (spike-and-channel
//            segments lock their slope from the first 2 pivots so it doesn't
//            drift). If na, the hull slope is computed. The slope actually used
//            is returned so the caller can lock it after the first valid draw.
// Returns [new_chain, new_parallel, new_center, n_chain_found, used_slope]
update_current_channel(leg_direction, leg_start_idx, cur_chain, cur_par, cur_cen, min_grade, maj, float in_locked_slope) =>
    new_chain = cur_chain
    new_par   = cur_par
    new_cen   = cur_cen
    dbg_n_chain = 0
    float used_slope = na
    if (maj ? show_major : show_channels)
        if leg_start_idx >= 0
            chain_kind = leg_direction == 1 ? -1 : 1   // lows for UP, highs for DOWN
            n = array.size(piv_bars)
            // Pass 1: a SUPPORT/RESISTANCE trendline the pivots actually sit ON,
            // so a channel break is unambiguous. Anchor at the leftmost chain-side
            // pivot, then take the slope to the "binding" later pivot: the MIN
            // slope for UP (no low ends up below the line) or MAX slope for DOWN
            // (no high above it). That's the lower (UP) / upper (DOWN) hull through
            // 2+ pivots -- the edge TOUCHES the lows/highs rather than floating off
            // them the way a regression-offset line did. (A regression average put
            // only the single deepest low on the line.)
            anchor_idx = -1
            for i = leg_start_idx to n - 1
                if array.get(piv_kinds, i) == chain_kind and array.get(piv_grades, i) >= min_grade
                    if anchor_idx < 0
                        anchor_idx := i
            float hull_slope = na
            int   cn = 0
            // Guard anchor_idx < n-1 so the slope loop never runs descending
            // (Pine `for a to b` with a>b counts DOWN -> out-of-bounds get).
            if anchor_idx >= 0 and anchor_idx < n - 1
                x0 = array.get(piv_bars, anchor_idx)
                y0 = array.get(piv_prices, anchor_idx)
                for i = anchor_idx + 1 to n - 1
                    if array.get(piv_kinds, i) == chain_kind and array.get(piv_grades, i) >= min_grade
                        xi = array.get(piv_bars, i)
                        yi = array.get(piv_prices, i)
                        if xi != x0
                            s = (yi - y0) / (xi - x0)
                            cn := cn + 1
                            if na(hull_slope)
                                hull_slope := s
                            else if leg_direction == 1
                                hull_slope := math.min(hull_slope, s)
                            else
                                hull_slope := math.max(hull_slope, s)
            dbg_n_chain := cn
            // Locked slope (segment) overrides the hull; otherwise use the hull.
            // Draw if we have a slope from either source.
            slope = na(in_locked_slope) ? hull_slope : in_locked_slope
            if not na(slope)
                used_slope := slope
                // Pass 2: widen to envelop EVERY pivot (both kinds). With the hull
                // slope, the min residual equals the anchor AND binding-pivot
                // residual, so the trend-side edge passes through 2+ pivots
                // (clean touches); the opposite edge rides the extreme excursion.
                // Track the top-2 and bottom-2 residuals so the MAJOR layer can
                // drop a single overshoot on the non-trend side (an 'overshoot
                // anomaly' should poke OUT, not widen the channel) -- the
                // trend-side edge stays exact so support still touches the lows.
                float rmax1 = -1.0e18
                float rmax2 = -1.0e18
                float rmin1 =  1.0e18
                float rmin2 =  1.0e18
                int   nenv  = 0
                for i = leg_start_idx to n - 1
                    if array.get(piv_grades, i) >= min_grade
                        rb = array.get(piv_bars, i)
                        rp = array.get(piv_prices, i)
                        resid = rp - slope * rb
                        nenv := nenv + 1
                        if resid > rmax1
                            rmax2 := rmax1
                            rmax1 := resid
                        else if resid > rmax2
                            rmax2 := resid
                        if resid < rmin1
                            rmin2 := rmin1
                            rmin1 := resid
                        else if resid < rmin2
                            rmin2 := resid
                trim = maj and nenv >= 4
                float r_max = (trim and rmax2 > -1.0e17) ? rmax2 : rmax1
                float r_min = (trim and rmin2 <  1.0e17) ? rmin2 : rmin1
                // Keep the trend-defining edge exact (touch the lows/highs).
                if maj and leg_direction == 1
                    r_min := rmin1
                if maj and leg_direction == 2
                    r_max := rmax1
                left_x  = array.get(piv_bars, leg_start_idx)
                right_x = bar_index
                up_yL = slope * left_x  + r_max
                up_yR = slope * right_x + r_max
                lo_yL = slope * left_x  + r_min
                lo_yR = slope * right_x + r_min
                cen_yL = (up_yL + lo_yL) / 2.0
                cen_yR = (up_yR + lo_yR) / 2.0
                // Major layer: cyan (UP) / orange (DOWN), thicker so the two big
                // trend channels stand out over the minor green/red ones.
                c = maj ? (leg_direction == 1 ? color.aqua : color.orange) : (leg_direction == 1 ? color.green : color.red)
                lw = maj ? major_width : 1
                ext = channel_extend ? extend.right : extend.none
                // Delete prior live lines (avoid within-epoch accumulation)
                if not na(cur_chain)
                    line.delete(cur_chain)
                if not na(cur_par)
                    line.delete(cur_par)
                if not na(cur_cen)
                    line.delete(cur_cen)
                // chain = trend-defining edge (lows for UP / highs for DOWN);
                // par = opposite envelope. Both solid, center dotted.
                if leg_direction == 1
                    new_chain := line.new(left_x, lo_yL, right_x, lo_yR, color=c, width=lw, extend=ext)
                    new_par   := line.new(left_x, up_yL, right_x, up_yR, color=c, width=lw, extend=ext)
                else
                    new_chain := line.new(left_x, up_yL, right_x, up_yR, color=c, width=lw, extend=ext)
                    new_par   := line.new(left_x, lo_yL, right_x, lo_yR, color=c, width=lw, extend=ext)
                new_cen := line.new(left_x, cen_yL, right_x, cen_yR, color=color.new(c, 35), width=1, style=line.style_dotted, extend=ext)
    [new_chain, new_par, new_cen, dbg_n_chain, used_slope]

// Least-squares regression over the segment's CHAIN-side pivots (lows for UP /
// highs for DOWN) at grade >= min_grade, from seg_start_idx to the latest pivot.
// Also returns the MAX residual of those pivots from the fitted line -- the
// "does this regression still fit?" measure used to split a spike from a channel.
// Returns [slope, intercept, count, max_residual].
major_reg_fit(seg_start_idx, min_grade, chain_kind) =>
    n = array.size(piv_bars)
    int   cnt = 0
    float sx  = 0.0
    float sy  = 0.0
    float sxy = 0.0
    float sxx = 0.0
    if seg_start_idx >= 0
        for i = seg_start_idx to n - 1
            if array.get(piv_kinds, i) == chain_kind and array.get(piv_grades, i) >= min_grade
                b = array.get(piv_bars, i)
                p = array.get(piv_prices, i)
                cnt := cnt + 1
                sx  := sx + b
                sy  := sy + p
                sxy := sxy + b * p
                sxx := sxx + b * b
    float slope = na
    float intercept = na
    float maxres = 0.0
    den = cnt * sxx - sx * sx
    if cnt >= 2 and den != 0
        slope := (cnt * sxy - sx * sy) / den
        intercept := (sy - slope * sx) / cnt
        for i = seg_start_idx to n - 1
            if array.get(piv_kinds, i) == chain_kind and array.get(piv_grades, i) >= min_grade
                r = math.abs(array.get(piv_prices, i) - (slope * array.get(piv_bars, i) + intercept))
                maxres := math.max(maxres, r)
    [slope, intercept, cnt, maxres]

// Index of the last chain-side pivot (grade >= min_grade) strictly BEFORE
// before_idx within the segment -- the new segment's start when a fit breaks.
major_prev_chain(seg_start_idx, min_grade, chain_kind, before_idx) =>
    res = -1
    if seg_start_idx >= 0 and before_idx > seg_start_idx
        for i = seg_start_idx to before_idx - 1
            if array.get(piv_kinds, i) == chain_kind and array.get(piv_grades, i) >= min_grade
                res := i
    res

// === Process detections this bar ===========================================
thr = na(atr14) ? 0.0 : atr14 * leg_break_atr

// --- Grade C HIGH ---
if not na(ph_c_val)
    bx = bar_index - strength_c
    bp = ph_c_val
    // Slab uses the LEG'S structural reference when in a trend:
    //   - DOWN leg: compare to last_lh_price (the leg's resistance level)
    //   - INIT or UP leg: compare to immediate prior high
    // This way an isolated noisy spike won't flip a real LH into HH.
    ref_h = leg_dir == 2 and not na(last_lh_price) ? last_lh_price : last_h_price
    slab = na(ref_h) ? "?" : (bp > ref_h ? "HH" : "LH")
    last_h_price := bp
    // Counters
    if slab == "HH"
        n_hh := n_hh + 1
    else if slab == "LH"
        n_lh := n_lh + 1
    else
        n_q := n_q + 1
    n_c := n_c + 1
    // Push pivot record
    array.push(piv_bars, bx)
    array.push(piv_prices, bp)
    array.push(piv_kinds, 1)
    array.push(piv_grades, 1)
    array.push(piv_slabs, slab)
    new_idx = array.size(piv_bars) - 1
    // Capture pre-call leg direction for channel drawing
    old_leg_dir_h = leg_dir
    // Leg state compute (HL/LH chain)
    [leg_state, new_dir, new_last_hl, new_last_lh, new_eh_idx, new_el_idx, new_eh_price, new_el_price, legs_inc, retro_idx] = compute_leg_state(bp, 1, slab, new_idx, leg_dir, last_hl_price, last_lh_price, leg_extreme_h_idx, leg_extreme_l_idx, leg_extreme_h_price, leg_extreme_l_price, thr)
    leg_dir := new_dir
    last_hl_price := new_last_hl
    last_lh_price := new_last_lh
    leg_extreme_h_idx := new_eh_idx
    leg_extreme_l_idx := new_el_idx
    leg_extreme_h_price := new_eh_price
    leg_extreme_l_price := new_el_price
    n_legs := n_legs + legs_inc
    array.push(piv_leg_states, leg_state)
    if retro_idx >= 0
        retag_label(retro_idx, "TRANSITION")
        // Finalize the prior epoch's channel: clip it to this bar and leave
        // it on the chart (bounded). Then null the refs so the new epoch
        // starts fresh lines. (Deleting here was why "no channels" showed --
        // it removed the only completed channel each transition.)
        [new_rc, new_rsi, new_bch, new_bp, new_bn] = register_finalized(cur_leg_trendline, cur_leg_parallel, cur_leg_center, bar_index, channel_epoch_start_idx, new_idx, run_count, run_start_idx, broad_chain, broad_par, broad_cen)
        run_count := new_rc
        run_start_idx := new_rsi
        broad_chain := new_bch
        broad_par := new_bp
        broad_cen := new_bn
        cur_leg_trendline := na
        cur_leg_parallel := na
        cur_leg_center := na
        leg_start_pivot_idx := new_idx
        // Backtrack the new channel to the pivot that INITIATED the CHoCH:
        // the prior leg's extreme (the BLACK swing high/low = retro_idx).
        // Scanning from there catches the first LH (new DOWN) / first HL
        // (new UP) that signaled the character change, so the channel
        // anchors at the reversal point instead of the later break pivot.
        channel_epoch_start_idx := retro_idx >= 0 ? retro_idx : new_idx
    else if legs_inc == 1
        leg_start_pivot_idx := new_idx
        channel_epoch_start_idx := new_idx
    // (Mid-leg CHoCH check removed: was firing on every minor LL/HH and
    // resetting the epoch before 2 chain pivots could accumulate, so the
    // channel never appeared. TRANSITION is the only epoch boundary now;
    // it already requires a "significant break" via leg_break_atr.)
    // Draw this pivot's label
    lab = draw_label_for(bx, bp, 1, slab, 1, leg_state)
    array.push(piv_labs, lab)
    // Adaptive channel update for the current epoch
    if leg_dir != 0
        [new_tl, new_pl, new_cn, dbg_n, _mus] = update_current_channel(leg_dir, channel_epoch_start_idx, cur_leg_trendline, cur_leg_parallel, cur_leg_center, 1, false, na)
        cur_leg_trendline := new_tl
        cur_leg_parallel := new_pl
        cur_leg_center := new_cn
        last_n_chain := dbg_n
        if not na(new_tl)
            n_channel_draws := n_channel_draws + 1

// --- Grade C LOW ---
if not na(pl_c_val)
    bx = bar_index - strength_c
    bp = pl_c_val
    // In UP leg: compare to last_hl_price (the leg's support). Else: prior fractal.
    ref_l = leg_dir == 1 and not na(last_hl_price) ? last_hl_price : last_l_price
    slab = na(ref_l) ? "?" : (bp < ref_l ? "LL" : "HL")
    last_l_price := bp
    if slab == "HL"
        n_hl := n_hl + 1
    else if slab == "LL"
        n_ll := n_ll + 1
    else
        n_q := n_q + 1
    n_c := n_c + 1
    array.push(piv_bars, bx)
    array.push(piv_prices, bp)
    array.push(piv_kinds, -1)
    array.push(piv_grades, 1)
    array.push(piv_slabs, slab)
    new_idx = array.size(piv_bars) - 1
    old_leg_dir_l = leg_dir
    [leg_state, new_dir, new_last_hl, new_last_lh, new_eh_idx, new_el_idx, new_eh_price, new_el_price, legs_inc, retro_idx] = compute_leg_state(bp, -1, slab, new_idx, leg_dir, last_hl_price, last_lh_price, leg_extreme_h_idx, leg_extreme_l_idx, leg_extreme_h_price, leg_extreme_l_price, thr)
    leg_dir := new_dir
    last_hl_price := new_last_hl
    last_lh_price := new_last_lh
    leg_extreme_h_idx := new_eh_idx
    leg_extreme_l_idx := new_el_idx
    leg_extreme_h_price := new_eh_price
    leg_extreme_l_price := new_el_price
    n_legs := n_legs + legs_inc
    array.push(piv_leg_states, leg_state)
    if retro_idx >= 0
        retag_label(retro_idx, "TRANSITION")
        // Finalize (clip + keep on chart) instead of deleting -- see the high
        // block above for the rationale.
        [new_rc, new_rsi, new_bch, new_bp, new_bn] = register_finalized(cur_leg_trendline, cur_leg_parallel, cur_leg_center, bar_index, channel_epoch_start_idx, new_idx, run_count, run_start_idx, broad_chain, broad_par, broad_cen)
        run_count := new_rc
        run_start_idx := new_rsi
        broad_chain := new_bch
        broad_par := new_bp
        broad_cen := new_bn
        cur_leg_trendline := na
        cur_leg_parallel := na
        cur_leg_center := na
        leg_start_pivot_idx := new_idx
        // Backtrack to the CHoCH-initiating pivot (prior leg's BLACK extreme).
        channel_epoch_start_idx := retro_idx >= 0 ? retro_idx : new_idx
    else if legs_inc == 1
        leg_start_pivot_idx := new_idx
        channel_epoch_start_idx := new_idx
    // (Mid-leg CHoCH check removed: was firing on every minor LL and
    // resetting the epoch before 2 chain pivots could accumulate.
    // TRANSITION already encodes "significant break" via leg_break_atr.)
    lab = draw_label_for(bx, bp, -1, slab, 1, leg_state)
    array.push(piv_labs, lab)
    if leg_dir != 0
        [new_tl, new_pl, new_cn, dbg_n, _mus] = update_current_channel(leg_dir, channel_epoch_start_idx, cur_leg_trendline, cur_leg_parallel, cur_leg_center, 1, false, na)
        cur_leg_trendline := new_tl
        cur_leg_parallel := new_pl
        cur_leg_center := new_cn
        last_n_chain := dbg_n
        if not na(new_tl)
            n_channel_draws := n_channel_draws + 1

// Helper inline: when upgrade reclassifies slab, decrement old-slab counter
// and increment new-slab counter so the status table stays accurate.
// (Pine doesn't support functions mutating globals, so this is open-coded.)

// --- Grade B upgrades ---
if not na(ph_b_val)
    [old_g, found_idx, old_sl, new_sl] = upgrade_pivot_grade(bar_index - strength_b, 1, 2)
    if found_idx >= 0
        if old_g < 2
            n_b := n_b + 1
            if old_g == 1
                n_c := n_c - 1
        if old_sl != new_sl
            if old_sl == "HH"
                n_hh := n_hh - 1
            else if old_sl == "LH"
                n_lh := n_lh - 1
            if new_sl == "HH"
                n_hh := n_hh + 1
            else if new_sl == "LH"
                n_lh := n_lh + 1
if not na(pl_b_val)
    [old_g, found_idx, old_sl, new_sl] = upgrade_pivot_grade(bar_index - strength_b, -1, 2)
    if found_idx >= 0
        if old_g < 2
            n_b := n_b + 1
            if old_g == 1
                n_c := n_c - 1
        if old_sl != new_sl
            if old_sl == "HL"
                n_hl := n_hl - 1
            else if old_sl == "LL"
                n_ll := n_ll - 1
            if new_sl == "HL"
                n_hl := n_hl + 1
            else if new_sl == "LL"
                n_ll := n_ll + 1

// --- Grade A upgrades ---
if not na(ph_a_val)
    [old_g, found_idx, old_sl, new_sl] = upgrade_pivot_grade(bar_index - strength_a, 1, 3)
    if found_idx >= 0
        if old_g < 3
            n_a := n_a + 1
            if old_g == 1
                n_c := n_c - 1
            else if old_g == 2
                n_b := n_b - 1
        if old_sl != new_sl
            if old_sl == "HH"
                n_hh := n_hh - 1
            else if old_sl == "LH"
                n_lh := n_lh - 1
            if new_sl == "HH"
                n_hh := n_hh + 1
            else if new_sl == "LH"
                n_lh := n_lh + 1
    // ---- MAJOR leg machine: feed this freshly-confirmed Grade-A HIGH ----
    if found_idx >= 0 and old_g < 3
        m_price = array.get(piv_prices, found_idx)
        m_ref = find_prev_significant_price(found_idx, 1, 3)
        m_slab = na(m_ref) ? "?" : (m_price > m_ref ? "HH" : "LH")
        m_thr = na(atr14) ? 0.0 : atr14 * major_break_atr
        [m_st, m_nd, m_nhl, m_nlh, m_neh, m_nel, m_nehp, m_nelp, m_inc, m_retro] = compute_leg_state(m_price, 1, m_slab, found_idx, m_leg_dir, m_last_hl, m_last_lh, m_eh_idx, m_el_idx, m_eh_price, m_el_price, m_thr)
        m_leg_dir  := m_nd
        m_last_hl  := m_nhl
        m_last_lh  := m_nlh
        m_eh_idx   := m_neh
        m_el_idx   := m_nel
        m_eh_price := m_nehp
        m_el_price := m_nelp
        if m_retro >= 0
            // Major CHoCH reversal: finalize the live segment, start a fresh
            // leg + segment anchored at the CHoCH pivot (prior leg extreme).
            finalize_channel(m_chain, bar_index)
            finalize_channel(m_par, bar_index)
            finalize_channel(m_cen, bar_index)
            m_chain := na
            m_par   := na
            m_cen   := na
            m_seg_start_idx := m_retro
        else if m_inc == 1
            m_seg_start_idx := found_idx
        else if m_seg_start_idx < 0 and m_leg_dir != 0
            // Restart a segment after a clean close-below-support break finalized
            // the prior channel (m_seg_start_idx was set to -1 there).
            m_seg_start_idx := found_idx
        // Piecewise-regression fit-break: this HIGH is a chain pivot only in a
        // DOWN leg. When the segment's regression no longer fits the chain highs
        // (max residual > tol), finalize and restart at the prior chain pivot --
        // a real slope change (spike -> channel), not a wiggle.
        if m_leg_dir == 2 and m_seg_start_idx >= 0
            [fm, fb, fcnt, fmax] = major_reg_fit(m_seg_start_idx, major_min_grade, 1)
            if fcnt >= 3 and fmax > major_fit_atr * (na(atr14) ? 0.0 : atr14)
                pc = major_prev_chain(m_seg_start_idx, major_min_grade, 1, found_idx)
                finalize_channel(m_chain, bar_index)
                finalize_channel(m_par, bar_index)
                finalize_channel(m_cen, bar_index)
                m_chain := na
                m_par   := na
                m_cen   := na
                m_seg_start_idx := pc >= 0 ? pc : m_seg_start_idx
        // Redraw the live segment with its developing regression slope.
        if m_leg_dir != 0 and m_seg_start_idx >= 0
            ck = m_leg_dir == 1 ? -1 : 1
            [rm, rb, rcnt, rmx] = major_reg_fit(m_seg_start_idx, major_min_grade, ck)
            if rcnt >= 2 and not na(rm)
                [mc, mp, mcen, mdb, mused] = update_current_channel(m_leg_dir, m_seg_start_idx, m_chain, m_par, m_cen, major_min_grade, true, rm)
                m_chain := mc
                m_par   := mp
                m_cen   := mcen
if not na(pl_a_val)
    [old_g, found_idx, old_sl, new_sl] = upgrade_pivot_grade(bar_index - strength_a, -1, 3)
    if found_idx >= 0
        if old_g < 3
            n_a := n_a + 1
            if old_g == 1
                n_c := n_c - 1
            else if old_g == 2
                n_b := n_b - 1
        if old_sl != new_sl
            if old_sl == "HL"
                n_hl := n_hl - 1
            else if old_sl == "LL"
                n_ll := n_ll - 1
            if new_sl == "HL"
                n_hl := n_hl + 1
            else if new_sl == "LL"
                n_ll := n_ll + 1
    // ---- MAJOR leg machine: feed this freshly-confirmed Grade-A LOW ----
    if found_idx >= 0 and old_g < 3
        m_price = array.get(piv_prices, found_idx)
        m_ref = find_prev_significant_price(found_idx, -1, 3)
        m_slab = na(m_ref) ? "?" : (m_price < m_ref ? "LL" : "HL")
        m_thr = na(atr14) ? 0.0 : atr14 * major_break_atr
        [m_st, m_nd, m_nhl, m_nlh, m_neh, m_nel, m_nehp, m_nelp, m_inc, m_retro] = compute_leg_state(m_price, -1, m_slab, found_idx, m_leg_dir, m_last_hl, m_last_lh, m_eh_idx, m_el_idx, m_eh_price, m_el_price, m_thr)
        m_leg_dir  := m_nd
        m_last_hl  := m_nhl
        m_last_lh  := m_nlh
        m_eh_idx   := m_neh
        m_el_idx   := m_nel
        m_eh_price := m_nehp
        m_el_price := m_nelp
        if m_retro >= 0
            finalize_channel(m_chain, bar_index)
            finalize_channel(m_par, bar_index)
            finalize_channel(m_cen, bar_index)
            m_chain := na
            m_par   := na
            m_cen   := na
            m_seg_start_idx := m_retro
        else if m_inc == 1
            m_seg_start_idx := found_idx
        else if m_seg_start_idx < 0 and m_leg_dir != 0
            m_seg_start_idx := found_idx
        // Piecewise-regression fit-break (this LOW is a chain pivot only in an
        // UP leg). Finalize + restart at the prior chain low when the segment's
        // support regression stops fitting the chain lows.
        if m_leg_dir == 1 and m_seg_start_idx >= 0
            [fm, fb, fcnt, fmax] = major_reg_fit(m_seg_start_idx, major_min_grade, -1)
            if fcnt >= 3 and fmax > major_fit_atr * (na(atr14) ? 0.0 : atr14)
                pc = major_prev_chain(m_seg_start_idx, major_min_grade, -1, found_idx)
                finalize_channel(m_chain, bar_index)
                finalize_channel(m_par, bar_index)
                finalize_channel(m_cen, bar_index)
                m_chain := na
                m_par   := na
                m_cen   := na
                m_seg_start_idx := pc >= 0 ? pc : m_seg_start_idx
        // Redraw the live segment with its developing regression slope.
        if m_leg_dir != 0 and m_seg_start_idx >= 0
            ck = m_leg_dir == 1 ? -1 : 1
            [rm, rb, rcnt, rmx] = major_reg_fit(m_seg_start_idx, major_min_grade, ck)
            if rcnt >= 2 and not na(rm)
                [mc, mp, mcen, mdb, mused] = update_current_channel(m_leg_dir, m_seg_start_idx, m_chain, m_par, m_cen, major_min_grade, true, rm)
                m_chain := mc
                m_par   := mp
                m_cen   := mcen

// Major channel termination (every bar): a channel extends to the right until
// price CLOSES beyond its trend-side line -- UP: close < support / DOWN: close >
// resistance. That clean break finalizes the channel here (not at the next
// pivot); the segment then restarts at the next major pivot. m_chain is the
// support line for UP / resistance line for DOWN (see update_current_channel).
if show_major and not na(m_chain) and m_leg_dir != 0
    cx1 = line.get_x1(m_chain)
    cy1 = line.get_y1(m_chain)
    cx2 = line.get_x2(m_chain)
    cy2 = line.get_y2(m_chain)
    csl = cx2 != cx1 ? (cy2 - cy1) / (cx2 - cx1) : 0.0
    trend_y_now = cy1 + csl * (bar_index - cx1)
    mgn = major_break_margin_atr * (na(atr14) ? 0.0 : atr14)
    broke = m_leg_dir == 1 ? close < trend_y_now - mgn : close > trend_y_now + mgn
    if broke
        finalize_channel(m_chain, bar_index)
        finalize_channel(m_par, bar_index)
        finalize_channel(m_cen, bar_index)
        m_chain := na
        m_par   := na
        m_cen   := na
        m_seg_start_idx := -1

// Status table ---------------------------------------------------------------
var table tbl = table.new(position.top_right, 2, 13, bgcolor=color.new(color.gray, 80), border_width=1)
if barstate.islast
    leg_dir_s = leg_dir == 0 ? "INIT" : leg_dir == 1 ? "UP" : "DOWN"
    table.cell(tbl, 0, 0, "Leg dir", text_color=color.black, text_size=size.normal)
    table.cell(tbl, 1, 0, leg_dir_s, text_color=color.black, text_size=size.normal)
    table.cell(tbl, 0, 1, "Channels drawn", text_color=color.blue, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(n_channel_draws), text_color=color.blue, text_size=size.small)
    table.cell(tbl, 0, 2, "Last n_chain", text_color=color.blue, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(last_n_chain), text_color=color.blue, text_size=size.small)
    table.cell(tbl, 0, 3, "Legs",    text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(n_legs), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 4, "Grade A", text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(n_a), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 5, "Grade B", text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(n_b), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 6, "Grade C", text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(n_c), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 7, "HH", text_color=color.green, text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(n_hh), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 8, "HL", text_color=color.green, text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(n_hl), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 9, "LH", text_color=color.red,   text_size=size.small)
    table.cell(tbl, 1, 9, str.tostring(n_lh), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 10, "LL", text_color=color.red,  text_size=size.small)
    table.cell(tbl, 1, 10, str.tostring(n_ll), text_color=color.black, text_size=size.small)
    table.cell(tbl, 0, 11, "?",  text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 11, str.tostring(n_q),  text_color=color.black, text_size=size.small)
    m_dir_s = m_leg_dir == 0 ? "INIT" : m_leg_dir == 1 ? "UP" : "DOWN"
    table.cell(tbl, 0, 12, "Major dir", text_color=color.teal, text_size=size.small)
    table.cell(tbl, 1, 12, m_dir_s, text_color=color.teal, text_size=size.small)
