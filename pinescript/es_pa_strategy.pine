//@version=5
// ES Price Action - v1 STRATEGY
// 2-legged pullback strategy. Same detection state machine as the v4 indicator,
// with strategy.entry / strategy.exit wired up so TV runs the backtest natively.
//
// Defaults are set to the best cell from the Python backtest:
//   - LONG-only (shorts lost money on the 60-day /ES sample which was bull-dominant)
//   - Quality score >= 6 (grade A and B - captures the +$588 LONG B cell)
//   - Structural stop (1 tick beyond leg-2 low)
//   - Swing-high target (top of pullback)
//   - RTH session only (9:30-16:00 ET)
//
// To enable shorts: flip "allow shorts" to true (treat results with caution
// on bull-trend periods until validated on bear-period data).

strategy("ES PA Strategy v1", overlay=true, initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=1.25, slippage=1, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false, max_labels_count=500, max_lines_count=500)

// ----------------------------------------------------------------------------
// Inputs - Detection
// ----------------------------------------------------------------------------
ema_length         = input.int(21,  "EMA length",            minval=5, maxval=200,  group="01 Detection")
ema_slope_lookback = input.int(5,   "EMA slope lookback (bars)", minval=1, maxval=30, group="01 Detection")
ema_prox_ticks     = input.int(8,   "EMA proximity (ticks)", minval=0, maxval=80,  group="01 Detection")
min_pullback_ticks = input.int(8,   "Min pullback depth (ticks)", minval=0, maxval=80, group="01 Detection")
max_leg_bars       = input.int(15,  "Max bars per leg", minval=2, maxval=50,       group="01 Detection")
require_sig_bar    = input.bool(false, "Require valid signal bar on trigger",       group="01 Detection")
min_close_strength = input.float(0.55, "  Signal bar: min close strength", minval=0.0, maxval=1.0, step=0.05, group="01 Detection")
min_body_fraction  = input.float(0.40, "  Signal bar: min body fraction",  minval=0.0, maxval=1.0, step=0.05, group="01 Detection")

// ----------------------------------------------------------------------------
// Inputs - Quality + sides
// ----------------------------------------------------------------------------
min_quality_score = input.int(6,   "Min quality score (0-10)", minval=0, maxval=10, tooltip="6 = grades B+ (recommended). 8 = A only. 0 = take everything.", group="02 Quality / sides")
allow_longs       = input.bool(true,  "Allow longs",  group="02 Quality / sides")
allow_shorts      = input.bool(false, "Allow shorts", tooltip="OFF by default. Backtest showed shorts losing on bull-dominant data; enable carefully.", group="02 Quality / sides")

// ----------------------------------------------------------------------------
// Inputs - Exits
// ----------------------------------------------------------------------------
stop_mode    = input.string("structural", "Stop mode",   options=["structural", "fixed_ticks"], group="03 Exits")
stop_ticks   = input.int(8,   "Stop ticks (if fixed)", minval=1, maxval=80,                   group="03 Exits")
target_mode  = input.string("swing", "Target mode",     options=["swing", "fixed_1pt", "fixed_2pt"], group="03 Exits")
entry_expiry_bars = input.int(2, "Entry expiry (bars)", minval=1, maxval=20, tooltip="Cancel pending entry order if not filled within N bars.", group="03 Exits")

// ----------------------------------------------------------------------------
// Inputs - Risk + session
// ----------------------------------------------------------------------------
rth_only         = input.bool(true,  "RTH only (09:30-16:00 ET)",     group="04 Risk / session")
max_daily_trades = input.int(6,      "Max trades per day",            minval=1, maxval=50, group="04 Risk / session")
max_daily_loss   = input.float(750,  "Max daily loss ($)",            minval=50, group="04 Risk / session")

// ----------------------------------------------------------------------------
// Inputs - Visuals
// ----------------------------------------------------------------------------
show_ema         = input.bool(true, "Show 21 EMA",      group="05 Visuals")
show_leg_markers = input.bool(true, "Show leg dots",    group="05 Visuals")
draw_entry_lines = input.bool(true, "Draw entry / stop / target lines", group="05 Visuals")
line_extend_bars = input.int(40,    "Lines extend N bars",  minval=5, maxval=200, group="05 Visuals")

// ============================================================================
// Indicators + trend
// ============================================================================
tick_sz = syminfo.mintick
ema21   = ta.ema(close, ema_length)

plot(show_ema ? ema21 : na, "EMA", color=color.new(color.blue, 0), linewidth=2)

ema_up   = ema21 > ema21[ema_slope_lookback]
ema_down = ema21 < ema21[ema_slope_lookback]
bull_trend = ema_up   and close > ema21
bear_trend = ema_down and close < ema21

// Session
is_rth() =>
    h = hour(time, "America/New_York")
    m = minute(time, "America/New_York")
    d = dayofweek(time, "America/New_York")
    wkd = d >= dayofweek.monday and d <= dayofweek.friday
    aft = h > 9 or (h == 9 and m >= 30)
    bef = h < 16
    wkd and aft and bef
in_session = (not rth_only) or is_rth()

// Apply built-in risk caps
strategy.risk.max_intraday_filled_orders(max_daily_trades)
strategy.risk.max_intraday_loss(max_daily_loss, strategy.cash)

// ============================================================================
// Signal bar gate
// ============================================================================
rng     = high - low
body    = math.abs(close - open)
cs_bull = rng > 0 ? (close - low)  / rng : 0.0
cs_bear = rng > 0 ? (high - close) / rng : 0.0
valid_long_sig  = close > open and rng > 0 and body >= min_body_fraction * rng and cs_bull >= min_close_strength
valid_short_sig = close < open and rng > 0 and body >= min_body_fraction * rng and cs_bear >= min_close_strength

// ============================================================================
// BULL state machine + score
// ============================================================================
var int   bull_state          = 0
var int   bull_leg_start      = na
var float bull_swing_high     = na
var bool  bull_ema_touched    = false
var int   bull_l1_bars        = 0
var int   bull_l1_ll          = 0
var float bull_l1_low         = na
var int   bull_l2_bars        = 0
var int   bull_l2_ll          = 0
var float bull_l2_low         = na
var bool  bull_fire           = false
bull_fire := false

prox = ema_prox_ticks * tick_sz
bull_pb_continues = high <= high[1]
bull_pb_breaks    = high >  high[1]

if not bull_trend
    bull_state := 0
    bull_swing_high := na
    bull_ema_touched := false
    bull_l1_bars := 0
    bull_l1_ll := 0
    bull_l1_low := na
    bull_l2_bars := 0
    bull_l2_ll := 0
    bull_l2_low := na

if bull_trend
    if bull_state == 0
        if bull_pb_continues
            bull_state := 1
            bull_leg_start := bar_index
            bull_swing_high := high[1]
            bull_l1_bars := 1
            bull_l1_ll := low < low[1] ? 1 : 0
            bull_l1_low := low
            bull_l2_bars := 0
            bull_l2_ll := 0
            bull_l2_low := na
            bull_ema_touched := low <= ema21 + prox
    else if bull_state == 1
        if high > bull_swing_high
            bull_state := 0
        else if bar_index - bull_leg_start > max_leg_bars
            bull_state := 0
        else if bull_pb_breaks
            bull_state := 2
            bull_leg_start := bar_index
        else
            bull_l1_bars := bull_l1_bars + 1
            if low < low[1]
                bull_l1_ll := bull_l1_ll + 1
            bull_l1_low := math.min(bull_l1_low, low)
            if low <= ema21 + prox
                bull_ema_touched := true
    else if bull_state == 2
        if high > bull_swing_high
            bull_state := 0
        else if bull_pb_continues
            bull_state := 3
            bull_leg_start := bar_index
            bull_l2_bars := 1
            bull_l2_ll := low < low[1] ? 1 : 0
            bull_l2_low := low
            if low <= ema21 + prox
                bull_ema_touched := true
    else if bull_state == 3
        if high > bull_swing_high
            bull_state := 0
        else if bar_index - bull_leg_start > max_leg_bars
            bull_state := 0
        else if bull_pb_breaks
            bull_fire := true
            bull_state := 0
        else
            bull_l2_bars := bull_l2_bars + 1
            if low < low[1]
                bull_l2_ll := bull_l2_ll + 1
            bull_l2_low := math.min(bull_l2_low, low)
            if low <= ema21 + prox
                bull_ema_touched := true

// NOTE: forced float division. Pine v5 int/int truncates (e.g. 2/3 = 0).
bull_l1_mom  = bull_l1_bars > 0 ? bull_l1_ll * 1.0 / bull_l1_bars : 0.0
bull_l2_mom  = bull_l2_bars > 0 ? bull_l2_ll * 1.0 / bull_l2_bars : 0.0
bull_s_l1    = math.round(bull_l1_mom * 3)
bull_s_l2    = math.round(bull_l2_mom * 3)
bull_s_depth = (not na(bull_l2_low) and not na(bull_l1_low) and bull_l2_low >  bull_l1_low) ? 3 : ((not na(bull_l2_low) and not na(bull_l1_low) and bull_l2_low >= bull_l1_low - 2 * tick_sz) ? 1 : 0)
bull_s_bars  = (bull_l1_bars >= 2 and bull_l2_bars >= 2) ? 1 : 0
bull_score   = bull_s_l1 + bull_s_l2 + bull_s_depth + bull_s_bars
bull_depth_ok = not na(bull_swing_high) and not na(bull_l1_low) and (bull_swing_high - math.min(bull_l1_low, nz(bull_l2_low, bull_l1_low))) >= min_pullback_ticks * tick_sz

fire_2EL = bull_fire and bull_depth_ok and bull_ema_touched and bull_score >= min_quality_score and (not require_sig_bar or valid_long_sig) and allow_longs and in_session

// Capture entry / stop / target on the trigger bar
var float p_long_entry  = na
var float p_long_stop   = na
var float p_long_target = na
if fire_2EL
    p_long_entry  := high[1] + tick_sz
    p_long_stop   := stop_mode == "fixed_ticks" ? (p_long_entry - stop_ticks * tick_sz) : (nz(bull_l2_low, bull_l1_low) - tick_sz)
    p_long_target := target_mode == "fixed_1pt" ? (p_long_entry + 4 * tick_sz) : target_mode == "fixed_2pt" ? (p_long_entry + 8 * tick_sz) : bull_swing_high

// ============================================================================
// BEAR state machine + score
// ============================================================================
var int   bear_state          = 0
var int   bear_leg_start      = na
var float bear_swing_low      = na
var bool  bear_ema_touched    = false
var int   bear_l1_bars        = 0
var int   bear_l1_hh          = 0
var float bear_l1_high        = na
var int   bear_l2_bars        = 0
var int   bear_l2_hh          = 0
var float bear_l2_high        = na
var bool  bear_fire           = false
bear_fire := false

bear_pb_continues = low >= low[1]
bear_pb_breaks    = low <  low[1]

if not bear_trend
    bear_state := 0
    bear_swing_low := na
    bear_ema_touched := false
    bear_l1_bars := 0
    bear_l1_hh := 0
    bear_l1_high := na
    bear_l2_bars := 0
    bear_l2_hh := 0
    bear_l2_high := na

if bear_trend
    if bear_state == 0
        if bear_pb_continues
            bear_state := 1
            bear_leg_start := bar_index
            bear_swing_low := low[1]
            bear_l1_bars := 1
            bear_l1_hh := high > high[1] ? 1 : 0
            bear_l1_high := high
            bear_l2_bars := 0
            bear_l2_hh := 0
            bear_l2_high := na
            bear_ema_touched := high >= ema21 - prox
    else if bear_state == 1
        if low < bear_swing_low
            bear_state := 0
        else if bar_index - bear_leg_start > max_leg_bars
            bear_state := 0
        else if bear_pb_breaks
            bear_state := 2
            bear_leg_start := bar_index
        else
            bear_l1_bars := bear_l1_bars + 1
            if high > high[1]
                bear_l1_hh := bear_l1_hh + 1
            bear_l1_high := math.max(bear_l1_high, high)
            if high >= ema21 - prox
                bear_ema_touched := true
    else if bear_state == 2
        if low < bear_swing_low
            bear_state := 0
        else if bear_pb_continues
            bear_state := 3
            bear_leg_start := bar_index
            bear_l2_bars := 1
            bear_l2_hh := high > high[1] ? 1 : 0
            bear_l2_high := high
            if high >= ema21 - prox
                bear_ema_touched := true
    else if bear_state == 3
        if low < bear_swing_low
            bear_state := 0
        else if bar_index - bear_leg_start > max_leg_bars
            bear_state := 0
        else if bear_pb_breaks
            bear_fire := true
            bear_state := 0
        else
            bear_l2_bars := bear_l2_bars + 1
            if high > high[1]
                bear_l2_hh := bear_l2_hh + 1
            bear_l2_high := math.max(bear_l2_high, high)
            if high >= ema21 - prox
                bear_ema_touched := true

// NOTE: forced float division. Pine v5 int/int truncates (e.g. 2/3 = 0).
bear_l1_mom  = bear_l1_bars > 0 ? bear_l1_hh * 1.0 / bear_l1_bars : 0.0
bear_l2_mom  = bear_l2_bars > 0 ? bear_l2_hh * 1.0 / bear_l2_bars : 0.0
bear_s_l1    = math.round(bear_l1_mom * 3)
bear_s_l2    = math.round(bear_l2_mom * 3)
bear_s_depth = (not na(bear_l2_high) and not na(bear_l1_high) and bear_l2_high <  bear_l1_high) ? 3 : ((not na(bear_l2_high) and not na(bear_l1_high) and bear_l2_high <= bear_l1_high + 2 * tick_sz) ? 1 : 0)
bear_s_bars  = (bear_l1_bars >= 2 and bear_l2_bars >= 2) ? 1 : 0
bear_score   = bear_s_l1 + bear_s_l2 + bear_s_depth + bear_s_bars
bear_depth_ok = not na(bear_swing_low) and not na(bear_l1_high) and (math.max(bear_l1_high, nz(bear_l2_high, bear_l1_high)) - bear_swing_low) >= min_pullback_ticks * tick_sz

fire_2ES = bear_fire and bear_depth_ok and bear_ema_touched and bear_score >= min_quality_score and (not require_sig_bar or valid_short_sig) and allow_shorts and in_session

var float p_short_entry  = na
var float p_short_stop   = na
var float p_short_target = na
if fire_2ES
    p_short_entry  := low[1] - tick_sz
    p_short_stop   := stop_mode == "fixed_ticks" ? (p_short_entry + stop_ticks * tick_sz) : (nz(bear_l2_high, bear_l1_high) + tick_sz)
    p_short_target := target_mode == "fixed_1pt" ? (p_short_entry - 4 * tick_sz) : target_mode == "fixed_2pt" ? (p_short_entry - 8 * tick_sz) : bear_swing_low

// ============================================================================
// Channel detection (Brooks/Grimes leg-scoped, sticky)
// ----------------------------------------------------------------------------
// Anchors are FROZEN once a channel forms. Anchor A = first qualifying pivot
// of the leg; Anchor B = current best (only replaced by a more prominent
// pivot that further extends the trend). Channel persists until price closes
// through the TRENDLINE (near side) by N ATRs - the breakout. A poke of the
// TCL (far side, parallel line) is an OVERSHOOT - climactic reversal signal,
// NOT invalidation. This matches how Brooks holds his manually drawn lines.
//
// Bear channel:
//   Trendline (NEAR / upper) = line through 2 descending qualifying PHs
//   TCL (FAR / lower)        = parallel line through deepest PL between anchors
//   Breakout (invalidates)   = close > Trendline + breakout_atr * ATR
//   Overshoot (signal)       = low < TCL - overshoot_atr * ATR
//
// Bull channel: mirror.
// ============================================================================
channel_overshoot_atr     = input.float(0.25, "Channel overshoot threshold (xATR)", minval=0.05, maxval=2.0, step=0.05, group="06 Channel filter")
channel_breakout_atr      = input.float(0.25, "Channel breakout threshold (xATR)",  minval=0.05, maxval=2.0, step=0.05, group="06 Channel filter")
channel_block_bars        = input.int(30, "Block opposite trades after overshoot (bars)", minval=1, maxval=200, group="06 Channel filter")
channel_atr_prominence    = input.float(0.5, "Pivot prominence vs neighbors (xATR)", minval=0.0, maxval=3.0, step=0.1, tooltip="Pivot's high (or low) must stand out by at least this many ATRs from the highs (or lows) of neighboring bars on BOTH sides. Symmetric, no EMA dependency.", group="06 Channel filter")
channel_atr_confirmation  = input.float(1.0, "Pivot confirmation reversal (xATR)", minval=0.1, maxval=5.0, step=0.1, tooltip="ZigZag-style: a candidate pivot is only confirmed after price moves this many ATRs in the OPPOSITE direction. Filters out 'looked like a pivot but wasn't' wiggles.", group="06 Channel filter")
channel_min_pivots        = input.int(2, "Min pivots to form channel", minval=2, maxval=5, group="06 Channel filter")
channel_max_pivots        = input.int(8, "Max pivots in rolling window", minval=2, maxval=20, tooltip="Older pivots beyond this count are evicted from the regression set.", group="06 Channel filter")
channel_touch_atr         = input.float(0.5, "Touch tolerance (xATR)", minval=0.05, maxval=2.0, step=0.05, tooltip="A pivot counts as a 'touch' of the trendline if within this many ATRs of it.", group="06 Channel filter")
enable_channel_filter     = input.bool(true, "Enable channel overshoot filter", group="06 Channel filter")
draw_channels             = input.bool(true, "Draw active channel lines", group="06 Channel filter")
channel_pivot_strength    = input.int(3,  "Channel pivot strength (bars)", minval=1, maxval=10, group="06 Channel filter")
channel_method            = input.string("Andrews Pitchforks", "Channel method", options=["Andrews Pitchforks", "Convex Hull", "Linear Regression (legacy)"], tooltip="Andrews Pitchforks: one pitchfork per pivot-triple, accumulated (matches manual style with top/center/bottom lines). Convex Hull: single channel through extreme pivots. Linear Regression: legacy.", group="06 Channel filter")
pitchfork_retrace_min     = input.float(0.236, "Pitchfork retracement min", minval=0.0, maxval=1.0, step=0.05, tooltip="Reject pitchforks where the 2nd leg retraces less than this fraction of leg 1.", group="06 Channel filter")
pitchfork_retrace_max     = input.float(1.0,   "Pitchfork retracement max", minval=0.1, maxval=2.0, step=0.05, group="06 Channel filter")
pitchfork_extend_bars     = input.int(25,  "Pitchfork extend forward (bars)", minval=5, maxval=200, group="06 Channel filter")
pitchfork_max_count       = input.int(20,  "Max pitchforks on chart", minval=1, maxval=100, tooltip="Older pitchforks beyond this count are removed.", group="06 Channel filter")

atr14 = ta.atr(14)

// ============================================================================
// 3-Stage Pivot Detection (Brooks "major swing point" / LuxAlgo-style)
// ----------------------------------------------------------------------------
// Stage 1: Williams fractal candidate (ta.pivothigh / ta.pivotlow)
// Stage 2: Prominence vs LOCAL NEIGHBORS by N ATR. Symmetric - works for both
//          bull and bear; no EMA dependency.
// Stage 3: ZigZag confirmation - candidate is only "published" once price moves
//          N ATRs in the OPPOSITE direction (Brooks: trend-change attempt of
//          comparable size; Grimes: 1 ATR retracement confirms).
// ============================================================================

// Stage 1: candidates
ph_cand = ta.pivothigh(high, channel_pivot_strength, channel_pivot_strength)
pl_cand = ta.pivotlow(low,  channel_pivot_strength, channel_pivot_strength)

// Stage 2: prominence vs neighbors (3 bars left + 3 bars right of pivot bar)
// Pivot bar is at (bar_index - channel_pivot_strength). Compare pivot's high to
// the highest of the 3 bars on each side (excluding pivot bar).
ph_right_max = ta.highest(high, channel_pivot_strength)
ph_left_max  = ta.highest(high, channel_pivot_strength)[channel_pivot_strength + 1]
ph_nbr_max   = math.max(ph_left_max, ph_right_max)
ph_prominent = not na(ph_cand) and (ph_cand - ph_nbr_max) >= channel_atr_prominence * atr14[channel_pivot_strength]

pl_right_min = ta.lowest(low, channel_pivot_strength)
pl_left_min  = ta.lowest(low, channel_pivot_strength)[channel_pivot_strength + 1]
pl_nbr_min   = math.min(pl_left_min, pl_right_min)
pl_prominent = not na(pl_cand) and (pl_nbr_min - pl_cand) >= channel_atr_prominence * atr14[channel_pivot_strength]

// Stage 3: ZigZag confirmation
var float ph_pending_price = na
var int   ph_pending_bar   = na
var float pl_pending_price = na
var int   pl_pending_bar   = na

// Track the most extreme prominent candidate until it's confirmed or replaced
if ph_prominent
    if na(ph_pending_price) or ph_cand > ph_pending_price
        ph_pending_price := ph_cand
        ph_pending_bar   := bar_index - channel_pivot_strength
if pl_prominent
    if na(pl_pending_price) or pl_cand < pl_pending_price
        pl_pending_price := pl_cand
        pl_pending_bar   := bar_index - channel_pivot_strength

// Confirm when price moves N ATR in opposite direction
confirm_dist = channel_atr_confirmation * atr14
ph_confirmed = not na(ph_pending_price) and (ph_pending_price - low) >= confirm_dist
pl_confirmed = not na(pl_pending_price) and (high - pl_pending_price) >= confirm_dist

// Expose confirmed pivot's PRICE + BAR (might be many bars in the past)
// for the channel formation code that consumes ph_qualifies / pl_qualifies.
ph_qualifies = ph_confirmed
pl_qualifies = pl_confirmed
ph_value_final = ph_qualifies ? ph_pending_price : na
ph_bar_final   = ph_qualifies ? ph_pending_bar   : na
pl_value_final = pl_qualifies ? pl_pending_price : na
pl_bar_final   = pl_qualifies ? pl_pending_bar   : na

// Reset pending slots after publishing
if ph_confirmed
    ph_pending_price := na
    ph_pending_bar   := na
if pl_confirmed
    pl_pending_price := na
    pl_pending_bar   := na

// ============================================================================
// Unified alternating pivot stream (for Andrews Pitchforks)
// ----------------------------------------------------------------------------
// Maintains a strictly alternating PH/PL/PH/PL/... sequence. When a same-type
// pivot fires consecutively, keep the more extreme one (higher PH or lower PL).
// ============================================================================
var array<float> pf_pivot_prices = array.new<float>(0)
var array<int>   pf_pivot_bars   = array.new<int>(0)
var array<int>   pf_pivot_types  = array.new<int>(0)   // 1 = PH, -1 = PL
var int          pf_last_drawn   = 0                   // count of pivots already used to draw a pitchfork
var array<line>  pf_lines        = array.new<line>(0)  // historical pitchfork lines (3 per fork)

if ph_qualifies
    if array.size(pf_pivot_types) > 0 and array.last(pf_pivot_types) == 1
        // Replace last PH with higher one if applicable
        if ph_value_final > array.last(pf_pivot_prices)
            array.set(pf_pivot_prices, array.size(pf_pivot_prices) - 1, ph_value_final)
            array.set(pf_pivot_bars,   array.size(pf_pivot_bars)   - 1, ph_bar_final)
    else
        array.push(pf_pivot_prices, ph_value_final)
        array.push(pf_pivot_bars,   ph_bar_final)
        array.push(pf_pivot_types,  1)
if pl_qualifies
    if array.size(pf_pivot_types) > 0 and array.last(pf_pivot_types) == -1
        if pl_value_final < array.last(pf_pivot_prices)
            array.set(pf_pivot_prices, array.size(pf_pivot_prices) - 1, pl_value_final)
            array.set(pf_pivot_bars,   array.size(pf_pivot_bars)   - 1, pl_bar_final)
    else
        array.push(pf_pivot_prices, pl_value_final)
        array.push(pf_pivot_bars,   pl_bar_final)
        array.push(pf_pivot_types,  -1)

// Cap pivot stream so memory stays bounded
while array.size(pf_pivot_prices) > 100
    array.shift(pf_pivot_prices)
    array.shift(pf_pivot_bars)
    array.shift(pf_pivot_types)
    pf_last_drawn := math.max(0, pf_last_drawn - 1)

// ============================================================================
// Andrews Pitchforks - draw one per new alternating triple
// ============================================================================
if draw_channels and channel_method == "Andrews Pitchforks" and array.size(pf_pivot_prices) > pf_last_drawn and array.size(pf_pivot_prices) >= 3
    // Use the last 3 pivots in the stream
    n = array.size(pf_pivot_prices)
    p0_p = array.get(pf_pivot_prices, n - 3)
    p0_b = array.get(pf_pivot_bars,   n - 3)
    p0_t = array.get(pf_pivot_types,  n - 3)
    p1_p = array.get(pf_pivot_prices, n - 2)
    p1_b = array.get(pf_pivot_bars,   n - 2)
    p1_t = array.get(pf_pivot_types,  n - 2)
    p2_p = array.get(pf_pivot_prices, n - 1)
    p2_b = array.get(pf_pivot_bars,   n - 1)
    p2_t = array.get(pf_pivot_types,  n - 1)

    alternates = p0_t == p2_t and p0_t != p1_t
    leg1 = math.abs(p1_p - p0_p)
    leg2 = math.abs(p2_p - p1_p)
    retrace_ratio = leg1 > 0 ? leg2 / leg1 : 0.0
    retrace_ok = retrace_ratio >= pitchfork_retrace_min and retrace_ratio <= pitchfork_retrace_max

    if alternates and retrace_ok
        // Classic Andrews median: from P0 through midpoint of P1-P2
        mid_b = (p1_b + p2_b) / 2.0
        mid_p = (p1_p + p2_p) / 2.0
        slope = (mid_p - p0_p) / (mid_b - p0_b)

        // Lines extend from each anchor to (p2_b + extend_bars)
        right_x = p2_b + pitchfork_extend_bars

        // Median: from P0 to right_x
        median_right_y = p0_p + slope * (right_x - p0_b)
        median_line = line.new(p0_b, p0_p, right_x, median_right_y, color=color.new(color.gray, 30), width=1, style=line.style_dashed)
        array.push(pf_lines, median_line)

        // Upper tine: parallel through P1
        upper_intercept = p1_p - slope * p1_b
        upper_right_y = upper_intercept + slope * right_x
        upper_line = line.new(p1_b, p1_p, right_x, upper_right_y, color=color.new(color.black, 20), width=1)
        array.push(pf_lines, upper_line)

        // Lower tine: parallel through P2
        lower_intercept = p2_p - slope * p2_b
        lower_right_y = lower_intercept + slope * right_x
        lower_line = line.new(p2_b, p2_p, right_x, lower_right_y, color=color.new(color.black, 20), width=1)
        array.push(pf_lines, lower_line)

        // Cap historical pitchfork count (each fork = 3 lines)
        while array.size(pf_lines) > pitchfork_max_count * 3
            old_line = array.shift(pf_lines)
            line.delete(old_line)

    pf_last_drawn := array.size(pf_pivot_prices)

// ---- Bear channel state ----
var array<float> bear_pivot_h = array.new<float>()  // qualifying PHs (rolling window)
var array<int>   bear_pivot_b = array.new<int>()
var float bear_A_price = na    // leftmost pivot in window (for line drawing)
var int   bear_A_bar = na
var float bear_B_price = na    // rightmost pivot in window
var int   bear_B_bar = na
var float bear_C_price = na    // TCL anchor (deepest qualifying PL)
var int   bear_C_bar = na
var bool  bear_channel_active = false
var int   bear_touches = 0
var float bear_regression_slope = 0.0
var float bear_regression_intercept = 0.0

// ---- Bull channel state ----
var array<float> bull_pivot_l = array.new<float>()  // qualifying PLs
var array<int>   bull_pivot_b = array.new<int>()
var float bull_A_price = na
var int   bull_A_bar = na
var float bull_B_price = na
var int   bull_B_bar = na
var float bull_C_price = na    // TCL anchor (highest qualifying PH)
var int   bull_C_bar = na
var bool  bull_channel_active = false
var int   bull_touches = 0
var float bull_regression_slope = 0.0
var float bull_regression_intercept = 0.0

// ---- Helper: linear regression on (bars, prices) arrays ----
// Returns [slope, intercept]. Returns [0, 0] if degenerate.
linreg_arr(bars_arr, prices_arr) =>
    n = array.size(bars_arr)
    sum_x = 0.0
    sum_y = 0.0
    sum_xx = 0.0
    sum_xy = 0.0
    for i = 0 to n - 1
        x = array.get(bars_arr, i)
        y = array.get(prices_arr, i)
        sum_x  := sum_x + x
        sum_y  := sum_y + y
        sum_xx := sum_xx + x * x
        sum_xy := sum_xy + x * y
    mean_x = n > 0 ? sum_x / n : 0.0
    mean_y = n > 0 ? sum_y / n : 0.0
    denom  = sum_xx - n * mean_x * mean_x
    slope  = denom != 0 ? (sum_xy - n * mean_x * mean_y) / denom : 0.0
    intercept = mean_y - slope * mean_x
    [slope, intercept]

// ---- Helper: Upper convex hull of points sorted by x ----
// Returns an array of INDICES (into original arrays) forming the upper boundary.
// For bear trendline: pivots on this hull are the line's anchor candidates.
upper_hull_arr(bars_arr, prices_arr) =>
    n = array.size(bars_arr)
    hull = array.new<int>(0)
    for i = 0 to n - 1
        while array.size(hull) >= 2
            j2 = array.get(hull, array.size(hull) - 1)
            j1 = array.get(hull, array.size(hull) - 2)
            x1 = array.get(bars_arr, j1)
            y1 = array.get(prices_arr, j1)
            x2 = array.get(bars_arr, j2)
            y2 = array.get(prices_arr, j2)
            x3 = array.get(bars_arr, i)
            y3 = array.get(prices_arr, i)
            // Cross product of (j1->j2) and (j2->i). For UPPER hull keep right turns (cross < 0)
            cross_val = (x2 - x1) * (y3 - y2) - (y2 - y1) * (x3 - x2)
            if cross_val >= 0
                array.pop(hull)
            else
                break
        array.push(hull, i)
    hull

// ---- Helper: Lower convex hull ----
// Pivots on this hull form the lower boundary (for bull trendline).
lower_hull_arr(bars_arr, prices_arr) =>
    n = array.size(bars_arr)
    hull = array.new<int>(0)
    for i = 0 to n - 1
        while array.size(hull) >= 2
            j2 = array.get(hull, array.size(hull) - 1)
            j1 = array.get(hull, array.size(hull) - 2)
            x1 = array.get(bars_arr, j1)
            y1 = array.get(prices_arr, j1)
            x2 = array.get(bars_arr, j2)
            y2 = array.get(prices_arr, j2)
            x3 = array.get(bars_arr, i)
            y3 = array.get(prices_arr, i)
            cross_val = (x2 - x1) * (y3 - y2) - (y2 - y1) * (x3 - x2)
            if cross_val <= 0
                array.pop(hull)
            else
                break
        array.push(hull, i)
    hull

// ---- Helper: Choose best descending hull edge for bear trendline ----
// Among edges (i, i+1) in upper hull, returns the one whose slope is most
// negative (steepest descent) - that's the channel-defining edge.
// Returns [slope, intercept, anchor_idx_left, anchor_idx_right] from original arrays.
choose_bear_hull_edge(hull_indices, bars_arr, prices_arr) =>
    n = array.size(hull_indices)
    best_slope = 0.0
    best_left = -1
    best_right = -1
    if n >= 2
        for k = 0 to n - 2
            i_left = array.get(hull_indices, k)
            i_right = array.get(hull_indices, k + 1)
            x_l = array.get(bars_arr, i_left)
            y_l = array.get(prices_arr, i_left)
            x_r = array.get(bars_arr, i_right)
            y_r = array.get(prices_arr, i_right)
            slope = (y_r - y_l) / (x_r - x_l)
            if slope < best_slope or best_left == -1
                best_slope := slope
                best_left := i_left
                best_right := i_right
    if best_left >= 0
        x_l = array.get(bars_arr, best_left)
        y_l = array.get(prices_arr, best_left)
        intercept = y_l - best_slope * x_l
        [best_slope, intercept, best_left, best_right]
    else
        [0.0, 0.0, -1, -1]

// ---- Helper: Choose best ascending hull edge for bull trendline ----
choose_bull_hull_edge(hull_indices, bars_arr, prices_arr) =>
    n = array.size(hull_indices)
    best_slope = 0.0
    best_left = -1
    best_right = -1
    if n >= 2
        for k = 0 to n - 2
            i_left = array.get(hull_indices, k)
            i_right = array.get(hull_indices, k + 1)
            x_l = array.get(bars_arr, i_left)
            y_l = array.get(prices_arr, i_left)
            x_r = array.get(bars_arr, i_right)
            y_r = array.get(prices_arr, i_right)
            slope = (y_r - y_l) / (x_r - x_l)
            if slope > best_slope or best_left == -1
                best_slope := slope
                best_left := i_left
                best_right := i_right
    if best_left >= 0
        x_l = array.get(bars_arr, best_left)
        y_l = array.get(prices_arr, best_left)
        intercept = y_l - best_slope * x_l
        [best_slope, intercept, best_left, best_right]
    else
        [0.0, 0.0, -1, -1]

// ---- Bear channel: progressive outlier-aware update ----
if ph_qualifies
    ph_value = ph_value_final
    ph_bar   = ph_bar_final
    include_in_fit = true
    if bear_channel_active
        line_y_at_pivot = bear_regression_intercept + bear_regression_slope * ph_bar
        include_in_fit := math.abs(ph_value - line_y_at_pivot) <= channel_touch_atr * atr14
    if include_in_fit
        array.push(bear_pivot_h, ph_value)
        array.push(bear_pivot_b, ph_bar)
        while array.size(bear_pivot_h) > channel_max_pivots
            array.shift(bear_pivot_h)
            array.shift(bear_pivot_b)

if pl_qualifies and bear_channel_active
    pl_value = pl_value_final
    pl_bar   = pl_bar_final
    if pl_bar > bear_A_bar and (na(bear_C_price) or pl_value < bear_C_price)
        bear_C_price := pl_value
        bear_C_bar   := pl_bar

// Fit bear channel using the selected method
if array.size(bear_pivot_h) >= channel_min_pivots
    final_slope = 0.0
    final_intercept = 0.0
    anchor_l_bar = 0
    anchor_l_price = 0.0
    anchor_r_bar = 0
    anchor_r_price = 0.0
    fit_ok = false

    if channel_method == "Convex Hull"
        // Build upper hull and pick steepest descending edge as the trendline
        uh = upper_hull_arr(bear_pivot_b, bear_pivot_h)
        [slp_h, icpt_h, i_l, i_r] = choose_bear_hull_edge(uh, bear_pivot_b, bear_pivot_h)
        if slp_h < 0 and i_l >= 0
            final_slope := slp_h
            final_intercept := icpt_h
            anchor_l_bar := array.get(bear_pivot_b, i_l)
            anchor_l_price := array.get(bear_pivot_h, i_l)
            anchor_r_bar := array.get(bear_pivot_b, i_r)
            anchor_r_price := array.get(bear_pivot_h, i_r)
            fit_ok := true
    else
        // Linear Regression (legacy) - regression slope, then upper envelope shift
        [slp, _icpt] = linreg_arr(bear_pivot_b, bear_pivot_h)
        if slp < 0
            env_intercept = -1e10
            for i = 0 to array.size(bear_pivot_h) - 1
                xv = array.get(bear_pivot_b, i)
                yv = array.get(bear_pivot_h, i)
                required = yv - slp * xv
                env_intercept := math.max(env_intercept, required)
            final_slope := slp
            final_intercept := env_intercept
            anchor_l_bar := array.first(bear_pivot_b)
            anchor_l_price := final_intercept + final_slope * anchor_l_bar
            anchor_r_bar := array.last(bear_pivot_b)
            anchor_r_price := final_intercept + final_slope * anchor_r_bar
            fit_ok := true

    if fit_ok
        bear_regression_slope := final_slope
        bear_regression_intercept := final_intercept
        bear_A_bar := anchor_l_bar
        bear_A_price := anchor_l_price
        bear_B_bar := anchor_r_bar
        bear_B_price := anchor_r_price
        touches = 0
        for i = 0 to array.size(bear_pivot_h) - 1
            xv = array.get(bear_pivot_b, i)
            yv = array.get(bear_pivot_h, i)
            line_y = final_intercept + final_slope * xv
            if math.abs(yv - line_y) <= channel_touch_atr * atr14
                touches := touches + 1
        bear_touches := touches
        if bear_touches >= channel_min_pivots and not bear_channel_active
            bear_channel_active := true

// ---- Bull channel (mirror) ----
if pl_qualifies
    pl_value = pl_value_final
    pl_bar   = pl_bar_final
    include_in_fit = true
    if bull_channel_active
        line_y_at_pivot = bull_regression_intercept + bull_regression_slope * pl_bar
        include_in_fit := math.abs(pl_value - line_y_at_pivot) <= channel_touch_atr * atr14
    if include_in_fit
        array.push(bull_pivot_l, pl_value)
        array.push(bull_pivot_b, pl_bar)
        while array.size(bull_pivot_l) > channel_max_pivots
            array.shift(bull_pivot_l)
            array.shift(bull_pivot_b)

if ph_qualifies and bull_channel_active
    ph_value = ph_value_final
    ph_bar   = ph_bar_final
    if ph_bar > bull_A_bar and (na(bull_C_price) or ph_value > bull_C_price)
        bull_C_price := ph_value
        bull_C_bar   := ph_bar

if array.size(bull_pivot_l) >= channel_min_pivots
    final_slope = 0.0
    final_intercept = 0.0
    anchor_l_bar = 0
    anchor_l_price = 0.0
    anchor_r_bar = 0
    anchor_r_price = 0.0
    fit_ok = false

    if channel_method == "Convex Hull"
        lh = lower_hull_arr(bull_pivot_b, bull_pivot_l)
        [slp_h, icpt_h, i_l, i_r] = choose_bull_hull_edge(lh, bull_pivot_b, bull_pivot_l)
        if slp_h > 0 and i_l >= 0
            final_slope := slp_h
            final_intercept := icpt_h
            anchor_l_bar := array.get(bull_pivot_b, i_l)
            anchor_l_price := array.get(bull_pivot_l, i_l)
            anchor_r_bar := array.get(bull_pivot_b, i_r)
            anchor_r_price := array.get(bull_pivot_l, i_r)
            fit_ok := true
    else
        [slp, _icpt] = linreg_arr(bull_pivot_b, bull_pivot_l)
        if slp > 0
            env_intercept = 1e10
            for i = 0 to array.size(bull_pivot_l) - 1
                xv = array.get(bull_pivot_b, i)
                yv = array.get(bull_pivot_l, i)
                required = yv - slp * xv
                env_intercept := math.min(env_intercept, required)
            final_slope := slp
            final_intercept := env_intercept
            anchor_l_bar := array.first(bull_pivot_b)
            anchor_l_price := final_intercept + final_slope * anchor_l_bar
            anchor_r_bar := array.last(bull_pivot_b)
            anchor_r_price := final_intercept + final_slope * anchor_r_bar
            fit_ok := true

    if fit_ok
        bull_regression_slope := final_slope
        bull_regression_intercept := final_intercept
        bull_A_bar := anchor_l_bar
        bull_A_price := anchor_l_price
        bull_B_bar := anchor_r_bar
        bull_B_price := anchor_r_price
        touches = 0
        for i = 0 to array.size(bull_pivot_l) - 1
            xv = array.get(bull_pivot_b, i)
            yv = array.get(bull_pivot_l, i)
            line_y = final_intercept + final_slope * xv
            if math.abs(yv - line_y) <= channel_touch_atr * atr14
                touches := touches + 1
        bull_touches := touches
        if bull_touches >= channel_min_pivots and not bull_channel_active
            bull_channel_active := true

// ---- Channel line equations (using regression slope) ----
bear_slope = bear_regression_slope
bear_trendline_at(b) => bear_channel_active ? bear_regression_intercept + bear_regression_slope * b : na
bear_tcl_at(b) => bear_channel_active and not na(bear_C_price) ? bear_C_price + bear_regression_slope * (b - bear_C_bar) : na

bull_slope = bull_regression_slope
bull_trendline_at(b) => bull_channel_active ? bull_regression_intercept + bull_regression_slope * b : na
bull_tcl_at(b) => bull_channel_active and not na(bull_C_price) ? bull_C_price + bull_regression_slope * (b - bull_C_bar) : na

// ---- Channel line refs (declared here so breakout block can freeze them) ----
var line bear_tl_line     = na
var line bear_tcl_line    = na
var line bear_center_line = na
var line bull_tl_line     = na
var line bull_tcl_line    = na
var line bull_center_line = na

// ---- Channel invalidation (close through TRENDLINE = near side) ----
bear_trendline_now = bear_trendline_at(bar_index)
bull_trendline_now = bull_trendline_at(bar_index)
bear_breakout = bear_channel_active and not na(bear_trendline_now) and close > bear_trendline_now + channel_breakout_atr * atr14
bull_breakout = bull_channel_active and not na(bull_trendline_now) and close < bull_trendline_now - channel_breakout_atr * atr14

if bear_breakout
    // Freeze the lines in place as historical reference (gray, no more extending)
    if not na(bear_tl_line)
        line.set_x2(bear_tl_line, bar_index)
        line.set_color(bear_tl_line, color.new(color.gray, 40))
    if not na(bear_tcl_line)
        line.set_x2(bear_tcl_line, bar_index)
        line.set_color(bear_tcl_line, color.new(color.gray, 40))
    if not na(bear_center_line)
        line.set_x2(bear_center_line, bar_index)
        line.set_color(bear_center_line, color.new(color.gray, 60))
    bear_tl_line := na
    bear_tcl_line := na
    bear_center_line := na
    bear_channel_active := false
    bear_A_price := na
    bear_B_price := na
    bear_C_price := na
    bear_touches := 0
    bear_regression_slope := 0.0
    bear_regression_intercept := 0.0
    array.clear(bear_pivot_h)
    array.clear(bear_pivot_b)
if bull_breakout
    if not na(bull_tl_line)
        line.set_x2(bull_tl_line, bar_index)
        line.set_color(bull_tl_line, color.new(color.gray, 40))
    if not na(bull_tcl_line)
        line.set_x2(bull_tcl_line, bar_index)
        line.set_color(bull_tcl_line, color.new(color.gray, 40))
    if not na(bull_center_line)
        line.set_x2(bull_center_line, bar_index)
        line.set_color(bull_center_line, color.new(color.gray, 60))
    bull_tl_line := na
    bull_tcl_line := na
    bull_center_line := na
    bull_channel_active := false
    bull_A_price := na
    bull_B_price := na
    bull_C_price := na
    bull_touches := 0
    bull_regression_slope := 0.0
    bull_regression_intercept := 0.0
    array.clear(bull_pivot_l)
    array.clear(bull_pivot_b)

// ---- Overshoot detection (poke through TCL = far side) ----
bear_tcl_now = bear_tcl_at(bar_index)
bull_tcl_now = bull_tcl_at(bar_index)
bear_overshoot = bear_channel_active and not na(bear_tcl_now) and low < bear_tcl_now - channel_overshoot_atr * atr14
bull_overshoot = bull_channel_active and not na(bull_tcl_now) and high > bull_tcl_now + channel_overshoot_atr * atr14

// ---- Post-overshoot window ----
var int last_bear_overshoot_bar = na
var int last_bull_overshoot_bar = na
if bear_overshoot
    last_bear_overshoot_bar := bar_index
if bull_overshoot
    last_bull_overshoot_bar := bar_index

in_bear_post_overshoot = enable_channel_filter and not na(last_bear_overshoot_bar) and bar_index - last_bear_overshoot_bar < channel_block_bars
in_bull_post_overshoot = enable_channel_filter and not na(last_bull_overshoot_bar) and bar_index - last_bull_overshoot_bar < channel_block_bars

// ---- Channel line management ----
// Three parallel lines per channel (Andrews-pitchfork style):
//   1. Trendline (solid, thin)   - upper for bear / lower for bull (anchored at A,B)
//   2. TCL       (solid, thin)   - parallel through anchor C (opposite extreme)
//   3. Median    (dotted, thin)  - parallel halfway between the two
// On break: all three freeze in gray.
// Only draws when channel_method is NOT "Andrews Pitchforks" (which has its own drawing path above).
if draw_channels and channel_method != "Andrews Pitchforks" and bear_channel_active and not na(bear_C_price)
    right_x = bar_index + 10
    right_tl_y  = bear_trendline_at(right_x)
    right_tcl_y = bear_tcl_at(right_x)
    // Median anchor at A_bar = average of trendline & TCL at A_bar
    bear_tcl_at_A_bar = bear_C_price + bear_slope * (bear_A_bar - bear_C_bar)
    bear_med_A_y = (bear_A_price + bear_tcl_at_A_bar) / 2
    right_med_y = bear_med_A_y + bear_slope * (right_x - bear_A_bar)
    ch_color = in_bear_post_overshoot ? color.orange : color.red
    if na(bear_tl_line)
        bear_tl_line := line.new(bear_A_bar, bear_A_price, right_x, right_tl_y, color=ch_color, width=1)
    else
        line.set_xy1(bear_tl_line, bear_A_bar, bear_A_price)
        line.set_xy2(bear_tl_line, right_x, right_tl_y)
        line.set_color(bear_tl_line, ch_color)
    if na(bear_tcl_line)
        bear_tcl_line := line.new(bear_C_bar, bear_C_price, right_x, right_tcl_y, color=ch_color, width=1)
    else
        line.set_xy1(bear_tcl_line, bear_C_bar, bear_C_price)
        line.set_xy2(bear_tcl_line, right_x, right_tcl_y)
        line.set_color(bear_tcl_line, ch_color)
    if na(bear_center_line)
        bear_center_line := line.new(bear_A_bar, bear_med_A_y, right_x, right_med_y, color=color.new(ch_color, 50), width=1, style=line.style_dotted)
    else
        line.set_xy1(bear_center_line, bear_A_bar, bear_med_A_y)
        line.set_xy2(bear_center_line, right_x, right_med_y)
        line.set_color(bear_center_line, color.new(ch_color, 50))

if draw_channels and channel_method != "Andrews Pitchforks" and bull_channel_active and not na(bull_C_price)
    right_x = bar_index + 10
    right_tl_y  = bull_trendline_at(right_x)
    right_tcl_y = bull_tcl_at(right_x)
    bull_tcl_at_A_bar = bull_C_price + bull_slope * (bull_A_bar - bull_C_bar)
    bull_med_A_y = (bull_A_price + bull_tcl_at_A_bar) / 2
    right_med_y = bull_med_A_y + bull_slope * (right_x - bull_A_bar)
    ch_color = in_bull_post_overshoot ? color.orange : color.green
    if na(bull_tl_line)
        bull_tl_line := line.new(bull_A_bar, bull_A_price, right_x, right_tl_y, color=ch_color, width=1)
    else
        line.set_xy1(bull_tl_line, bull_A_bar, bull_A_price)
        line.set_xy2(bull_tl_line, right_x, right_tl_y)
        line.set_color(bull_tl_line, ch_color)
    if na(bull_tcl_line)
        bull_tcl_line := line.new(bull_C_bar, bull_C_price, right_x, right_tcl_y, color=ch_color, width=1)
    else
        line.set_xy1(bull_tcl_line, bull_C_bar, bull_C_price)
        line.set_xy2(bull_tcl_line, right_x, right_tcl_y)
        line.set_color(bull_tcl_line, ch_color)
    if na(bull_center_line)
        bull_center_line := line.new(bull_A_bar, bull_med_A_y, right_x, right_med_y, color=color.new(ch_color, 50), width=1, style=line.style_dotted)
    else
        line.set_xy1(bull_center_line, bull_A_bar, bull_med_A_y)
        line.set_xy2(bull_center_line, right_x, right_med_y)
        line.set_color(bull_center_line, color.new(ch_color, 50))

// ---- Diagnostic status label (ALWAYS drawn while debugging - ignores draw_channels) ----
var label channel_status_label = na
if barstate.islast
    if not na(channel_status_label)
        label.delete(channel_status_label)
    bear_state_text = bear_channel_active ? (in_bear_post_overshoot ? "BEAR-OVERSHOT(" + str.tostring(bar_index - last_bear_overshoot_bar) + "b)" : "BEAR-ACTIVE(" + str.tostring(bear_touches) + "t)") : (na(bear_A_price) ? "BEAR-none" : "BEAR-waiting-B")
    bull_state_text = bull_channel_active ? (in_bull_post_overshoot ? "BULL-OVERSHOT(" + str.tostring(bar_index - last_bull_overshoot_bar) + "b)" : "BULL-ACTIVE(" + str.tostring(bull_touches) + "t)") : (na(bull_A_price) ? "BULL-none" : "BULL-waiting-B")
    bear_anchors = "Bear A=" + (na(bear_A_price) ? "-" : str.tostring(bear_A_price, "#.##") + "@b" + str.tostring(bar_index - bear_A_bar)) + "  B=" + (na(bear_B_price) ? "-" : str.tostring(bear_B_price, "#.##") + "@b" + str.tostring(bar_index - bear_B_bar)) + "  C=" + (na(bear_C_price) ? "-" : str.tostring(bear_C_price, "#.##") + "@b" + str.tostring(bar_index - bear_C_bar))
    bull_anchors = "Bull A=" + (na(bull_A_price) ? "-" : str.tostring(bull_A_price, "#.##") + "@b" + str.tostring(bar_index - bull_A_bar)) + "  B=" + (na(bull_B_price) ? "-" : str.tostring(bull_B_price, "#.##") + "@b" + str.tostring(bar_index - bull_B_bar)) + "  C=" + (na(bull_C_price) ? "-" : str.tostring(bull_C_price, "#.##") + "@b" + str.tostring(bar_index - bull_C_bar))
    atr_text = "ATR=" + str.tostring(atr14, "#.##") + "  prom>=" + str.tostring(channel_atr_prominence * atr14, "#.##") + "  confirm>=" + str.tostring(channel_atr_confirmation * atr14, "#.##") + "  [" + channel_method + "]"
    status_text = bear_state_text + " | " + bull_state_text + "\n" + bear_anchors + "\n" + bull_anchors + "\n" + atr_text
    channel_status_label := label.new(bar_index, high, status_text, color=color.new(color.black, 20), textcolor=color.white, style=label.style_label_left, xloc=xloc.bar_index, size=size.normal)

// ============================================================================
// Helpers
// ============================================================================
grade_for(s) =>
    s >= 8 ? "A" : s >= 6 ? "B" : s >= 4 ? "C" : "D"
color_for(s) =>
    s >= 8 ? color.lime : s >= 6 ? color.new(#7fc97f, 0) : s >= 4 ? color.yellow : color.orange

// ============================================================================
// Strategy: place / refresh pending buy stop on every LEG2 bar
// ----------------------------------------------------------------------------
// Brooks-style: the buy stop sits above the last LEG2 bar's high. When the
// next bar breaks higher, it fills INTRABAR at the trigger price - not 1 bar
// late. We refresh every LEG2 bar so the stop tracks the most recent high.
// If state leaves LEG2 without filling (timeout, new HH abort, or quality
// degraded), the order is cancelled.
// ============================================================================
var int pending_long_bar  = na
var int pending_short_bar = na

bull_setup_active = bull_state == 3 and bull_ema_touched and bull_depth_ok and bull_score >= min_quality_score and (not require_sig_bar or valid_long_sig) and allow_longs and in_session and not in_bull_post_overshoot
bear_setup_active = bear_state == 3 and bear_ema_touched and bear_depth_ok and bear_score >= min_quality_score and (not require_sig_bar or valid_short_sig) and allow_shorts and in_session and not in_bear_post_overshoot

if bull_setup_active and strategy.position_size == 0
    p_long_entry  := high + tick_sz
    p_long_stop   := stop_mode == "fixed_ticks" ? (p_long_entry - stop_ticks * tick_sz) : (bull_l2_low - tick_sz)
    p_long_target := target_mode == "fixed_1pt" ? (p_long_entry + 4 * tick_sz) : target_mode == "fixed_2pt" ? (p_long_entry + 8 * tick_sz) : bull_swing_high
    if p_long_stop < p_long_entry and p_long_target > p_long_entry
        strategy.entry("2EL", strategy.long, stop=p_long_entry, comment="2EL " + grade_for(bull_score) + str.tostring(bull_score))
        strategy.exit("2EL_x", from_entry="2EL", stop=p_long_stop, limit=p_long_target, comment_loss="stop", comment_profit="target")
        pending_long_bar := bar_index

if bear_setup_active and strategy.position_size == 0
    p_short_entry  := low - tick_sz
    p_short_stop   := stop_mode == "fixed_ticks" ? (p_short_entry + stop_ticks * tick_sz) : (bear_l2_high + tick_sz)
    p_short_target := target_mode == "fixed_1pt" ? (p_short_entry - 4 * tick_sz) : target_mode == "fixed_2pt" ? (p_short_entry - 8 * tick_sz) : bear_swing_low
    if p_short_stop > p_short_entry and p_short_target < p_short_entry
        strategy.entry("2ES", strategy.short, stop=p_short_entry, comment="2ES " + grade_for(bear_score) + str.tostring(bear_score))
        strategy.exit("2ES_x", from_entry="2ES", stop=p_short_stop, limit=p_short_target, comment_loss="stop", comment_profit="target")
        pending_short_bar := bar_index

// Cancel pending orders when setup is no longer active and we're still flat
if not bull_setup_active and not na(pending_long_bar) and strategy.position_size == 0
    strategy.cancel("2EL")
    pending_long_bar := na
if not bear_setup_active and not na(pending_short_bar) and strategy.position_size == 0
    strategy.cancel("2ES")
    pending_short_bar := na

// Belt-and-suspenders: entry_expiry_bars cap (rarely hits since LEG2 has its own max_leg_bars)
if not na(pending_long_bar) and bar_index - pending_long_bar > entry_expiry_bars and strategy.position_size == 0
    strategy.cancel("2EL")
    pending_long_bar := na
if not na(pending_short_bar) and bar_index - pending_short_bar > entry_expiry_bars and strategy.position_size == 0
    strategy.cancel("2ES")
    pending_short_bar := na

// Clear pending tracker once filled
if strategy.position_size != 0
    pending_long_bar := na
    pending_short_bar := na

// ============================================================================
// Visual leg markers (helpful for sanity-checking detection)
// ============================================================================
in_bull_leg1 = bull_state == 1
in_bull_leg2 = bull_state == 3
in_bear_leg1 = bear_state == 1
in_bear_leg2 = bear_state == 3
plotshape(show_leg_markers and in_bull_leg1, title="bull leg1", style=shape.circle, location=location.belowbar, color=color.new(color.aqua,   50), size=size.tiny)
plotshape(show_leg_markers and in_bull_leg2, title="bull leg2", style=shape.circle, location=location.belowbar, color=color.new(color.yellow, 30), size=size.tiny)
plotshape(show_leg_markers and in_bear_leg1, title="bear leg1", style=shape.circle, location=location.abovebar, color=color.new(color.aqua,   50), size=size.tiny)
plotshape(show_leg_markers and in_bear_leg2, title="bear leg2", style=shape.circle, location=location.abovebar, color=color.new(color.yellow, 30), size=size.tiny)

// Entry / stop / target lines
if draw_entry_lines and fire_2EL
    line.new(bar_index, p_long_entry,  bar_index + line_extend_bars, p_long_entry,  color=color.white, width=1, style=line.style_dashed)
    line.new(bar_index, p_long_stop,   bar_index + line_extend_bars, p_long_stop,   color=color.red,   width=1, style=line.style_dotted)
    line.new(bar_index, p_long_target, bar_index + line_extend_bars, p_long_target, color=color.lime,  width=1, style=line.style_dotted)
if draw_entry_lines and fire_2ES
    line.new(bar_index, p_short_entry,  bar_index + line_extend_bars, p_short_entry,  color=color.white, width=1, style=line.style_dashed)
    line.new(bar_index, p_short_stop,   bar_index + line_extend_bars, p_short_stop,   color=color.red,   width=1, style=line.style_dotted)
    line.new(bar_index, p_short_target, bar_index + line_extend_bars, p_short_target, color=color.lime,  width=1, style=line.style_dotted)

// Signal labels
if fire_2EL
    label.new(bar_index, low, "2EL " + grade_for(bull_score) + str.tostring(bull_score), style=label.style_label_up, color=color_for(bull_score), textcolor=color.white, size=size.small, yloc=yloc.belowbar)
if fire_2ES
    label.new(bar_index, high, "2ES " + grade_for(bear_score) + str.tostring(bear_score), style=label.style_label_down, color=color_for(bear_score), textcolor=color.white, size=size.small, yloc=yloc.abovebar)

// ============================================================================
// Alerts
// ============================================================================
alertcondition(fire_2EL, title="2EL signal", message="ES PA Strategy: 2-legged pullback long")
alertcondition(fire_2ES, title="2ES signal", message="ES PA Strategy: 2-legged pullback short")
