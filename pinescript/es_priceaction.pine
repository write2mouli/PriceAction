//@version=5
// ESPriceAction - Brooks-style price action strategy.
// Designed for /ES on 5-minute (TV subscription without tick charts).
// Mirrors docs/strategy-spec.md. See ../python/ for the reference implementation.
strategy("ES Price Action", overlay=true, initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=1.25, slippage=1, calc_on_every_tick=false, process_orders_on_close=false, pyramiding=0)

// ============================================================================
// Inputs
// ============================================================================
grp_d  = "01 Detection"
grp_tl = "02 Trendline / Range / SR"
grp_su = "03 Setups"
grp_ex = "04 Exits"
grp_rk = "05 Risk"
grp_vi = "06 Visuals"

ema_length              = input.int(21,  "EMA length",         minval=5, maxval=200, group=grp_d)
atr_length              = input.int(14,  "ATR length",         minval=5, maxval=50,  group=grp_d)
swing_strength          = input.int(3,   "Swing strength",     minval=1, maxval=10,  group=grp_d)
ema_proximity_ticks     = input.int(4,   "EMA proximity (ticks)", minval=0, maxval=40, group=grp_d)
min_close_strength      = input.float(0.60, "Min close strength", minval=0.0, maxval=1.0, step=0.05, group=grp_d)
min_body_fraction       = input.float(0.40, "Min body fraction",  minval=0.0, maxval=1.0, step=0.05, group=grp_d)
max_signal_range_atr    = input.float(2.5,  "Max signal-bar range (xATR)", minval=1.0, maxval=5.0, step=0.1, group=grp_d)
min_pullback_ticks      = input.int(8,   "Min pullback (ticks)", minval=0, maxval=80, group=grp_d)
max_pullback_bars       = input.int(15,  "Max pullback (bars)",  minval=3, maxval=50, group=grp_d)
entry_expiry_bars       = input.int(2,   "Entry expiry (bars)",  minval=1, maxval=10, group=grp_d)
trend_bars_above_ema    = input.int(14,  "Trend bars above EMA (of 20)", minval=1, maxval=20, group=grp_d)

grp_rg = "02b Regime gates"
min_pullback_depth_frac = input.float(0.30, "Min pullback depth (frac of leg)", minval=0.0, maxval=1.0, step=0.05, group=grp_rg)
new_extreme_min_ticks   = input.int(4,   "New-extreme threshold (ticks)", minval=0, maxval=40, group=grp_rg)
new_extreme_cooldown    = input.int(5,   "New-extreme cooldown (bars)",   minval=0, maxval=50, group=grp_rg)
mid_range_low_frac      = input.float(0.40, "Mid-range low frac (block shorts below)", minval=0.0, maxval=1.0, step=0.05, group=grp_rg)
mid_range_high_frac     = input.float(0.60, "Mid-range high frac (block longs above)", minval=0.0, maxval=1.0, step=0.05, group=grp_rg)
enable_congestion       = input.bool(true, "Enable congestion filter",  group=grp_rg)
congestion_lookback     = input.int(10,  "Congestion lookback (bars)", minval=2, maxval=50, group=grp_rg)
congestion_max_range    = input.int(16,  "Congestion max range (ticks)", minval=1, maxval=80, group=grp_rg)
congestion_max_drift    = input.int(8,   "Congestion max drift (ticks)", minval=0, maxval=80, group=grp_rg)
enable_pb_tl            = input.bool(true, "Enable PB counter-TL KEP", group=grp_rg)
fb_require_pb_confirm   = input.bool(true, "FB require pullback confirmation", group=grp_rg)
fb_pullback_window      = input.int(8,  "FB pullback window (bars)", minval=1, maxval=30, group=grp_rg)
fb_lh_hl_min_ticks      = input.int(4,  "FB LH/HL min ticks", minval=0, maxval=40, group=grp_rg)

tl_pierce_ticks         = input.int(6,   "Trendline pierce (ticks)",   minval=0, maxval=40, group=grp_tl)
tl_break_ticks          = input.int(4,   "Trendline break (ticks)",    minval=0, maxval=40, group=grp_tl)
tl_violation_ticks      = input.int(4,   "Trendline violation (ticks)",minval=0, maxval=40, group=grp_tl)
tl_test_window          = input.int(20,  "TL test window (bars)",      minval=5, maxval=100, group=grp_tl)
sr_proximity_ticks      = input.int(4,   "SR proximity (ticks)",       minval=0, maxval=40, group=grp_tl)
range_lookback          = input.int(30,  "Range lookback (bars)",      minval=10, maxval=200, group=grp_tl)
range_band_ticks        = input.int(6,   "Range band (ticks)",         minval=0, maxval=40, group=grp_tl)
range_break_ticks       = input.int(6,   "Range break (ticks)",        minval=0, maxval=40, group=grp_tl)
range_break_bars        = input.int(3,   "Range break bars",           minval=1, maxval=20, group=grp_tl)
fail_breakout_max_ticks = input.int(20,  "Failed BO max pierce (ticks)", minval=0, maxval=200, group=grp_tl)
fail_breakout_window    = input.int(5,   "Failed BO window (bars)",    minval=1, maxval=20, group=grp_tl)
f2e_reversal_bars       = input.int(2,   "F2E reversal lookback (bars)", minval=1, maxval=10, group=grp_tl)

enable_2el_2es          = input.bool(true,  "Enable 2EL / 2ES",  group=grp_su)
enable_f2el_f2es        = input.bool(true,  "Enable F2EL / F2ES", group=grp_su)
enable_failed_breakout  = input.bool(true,  "Enable Failed Breakout", group=grp_su)
enable_hl_lh            = input.bool(true,  "Enable HL/LH reversal", group=grp_su)

stop_mode               = input.string("BEYOND_SIGNAL_BAR", "Stop mode", options=["BEYOND_SIGNAL_BAR","FIXED_POINTS","FIXED_TICKS","ATR","BEYOND_SWING"], group=grp_ex)
stop_points             = input.float(4.0,  "Stop points",     minval=0.25, maxval=100.0, step=0.25, group=grp_ex)
stop_ticks              = input.int(16,     "Stop ticks",      minval=1,    maxval=200, group=grp_ex)
stop_atr_mult           = input.float(1.5,  "Stop ATR mult",   minval=0.1,  maxval=10.0, step=0.1, group=grp_ex)

target_mode             = input.string("R_MULTIPLE", "Target mode", options=["FIXED_POINTS","FIXED_TICKS","R_MULTIPLE","MEASURED_MOVE","ATR","OPPOSITE_KEP"], group=grp_ex)
target_points           = input.float(2.0,  "Target points",   minval=0.25, maxval=100.0, step=0.25, group=grp_ex)
target_ticks            = input.int(8,      "Target ticks",    minval=1,    maxval=200, group=grp_ex)
target_r                = input.float(2.0,  "Target R-multiple", minval=0.25, maxval=10.0, step=0.25, group=grp_ex)
target_atr_mult         = input.float(3.0,  "Target ATR mult", minval=0.1, maxval=10.0, step=0.1, group=grp_ex)
min_rr_to_enter         = input.float(1.0,  "Min RR to enter",  minval=0.1, maxval=10.0, step=0.1, group=grp_ex)

allow_longs             = input.bool(true,  "Allow longs",  group=grp_rk)
allow_shorts            = input.bool(true,  "Allow shorts", group=grp_rk)
max_daily_loss_r        = input.float(3.0,  "Max daily loss (R)", minval=0.5, maxval=20.0, step=0.5, group=grp_rk)
max_daily_trades        = input.int(6,      "Max daily trades", minval=1, maxval=50, group=grp_rk)
cooldown_bars_after_loss= input.int(5,      "Cooldown bars after loss", minval=0, maxval=50, group=grp_rk)
rth_only                = input.bool(true,  "RTH session only (09:30-16:00 ET)", group=grp_rk)

draw_ema                = input.bool(true, "Draw EMA",         group=grp_vi)
draw_trendlines         = input.bool(true, "Draw trendlines",  group=grp_vi)
draw_range_box          = input.bool(true, "Draw range box",   group=grp_vi)
draw_signal_markers     = input.bool(true, "Draw signal markers", group=grp_vi)

// ============================================================================
// Helpers
// ============================================================================
tick_sz                 = syminfo.mintick
is_bull(o,c)            => c > o
is_bear(o,c)            => c < o
body(o,c)               => math.abs(c - o)
rng(h,l)                => h - l

is_rth_bar() =>
    // Use NY exchange timestamp; covers ETH/RTH split. 09:30-16:00 ET, weekdays.
    h = hour(time, "America/New_York")
    m = minute(time, "America/New_York")
    d = dayofweek(time, "America/New_York")
    weekday = d >= dayofweek.monday and d <= dayofweek.friday
    afterOpen = h > 9 or (h == 9 and m >= 30)
    beforeClose = h < 16
    weekday and afterOpen and beforeClose

// ============================================================================
// Indicators
// ============================================================================
ema21 = ta.ema(close, ema_length)
atrv  = ta.atr(atr_length)

plot(draw_ema ? ema21 : na, "EMA21", color=color.new(color.blue, 0), linewidth=1)

// ============================================================================
// Swing pivots (confirmed `swing_strength` bars later -- note bar shift)
// ============================================================================
pl = ta.pivotlow(low, swing_strength, swing_strength)
ph = ta.pivothigh(high, swing_strength, swing_strength)

var float last_sh_1 = na
var int   last_sh_1_bar = na
var float last_sh_2 = na
var int   last_sh_2_bar = na
var float last_sl_1 = na
var int   last_sl_1_bar = na
var float last_sl_2 = na
var int   last_sl_2_bar = na

if not na(ph)
    last_sh_2 := last_sh_1
    last_sh_2_bar := last_sh_1_bar
    last_sh_1 := ph
    last_sh_1_bar := bar_index - swing_strength
if not na(pl)
    last_sl_2 := last_sl_1
    last_sl_2_bar := last_sl_1_bar
    last_sl_1 := pl
    last_sl_1_bar := bar_index - swing_strength

// ============================================================================
// Trendlines -- connecting last two confirmed swing lows (bull) / highs (bear)
// ============================================================================
var line bull_tl_line = na
var line bear_tl_line = na
var int  bull_tl_x0 = na, var float bull_tl_y0 = na
var int  bull_tl_x1 = na, var float bull_tl_y1 = na
var int  bear_tl_x0 = na, var float bear_tl_y0 = na
var int  bear_tl_x1 = na, var float bear_tl_y1 = na
var int  broken_bull_tl_at = na
var int  broken_bear_tl_at = na

tl_value_at(x0, y0, x1, y1, x) =>
    slope = (x1 == x0) ? 0.0 : (y1 - y0) / (x1 - x0)
    y0 + slope * (x - x0)

// Try to (re)anchor bull trendline when we have 2 rising lows
if not na(last_sl_1) and not na(last_sl_2) and last_sl_1 > last_sl_2 and na(broken_bull_tl_at)
    bull_tl_x0 := last_sl_2_bar
    bull_tl_y0 := last_sl_2
    bull_tl_x1 := last_sl_1_bar
    bull_tl_y1 := last_sl_1
if not na(last_sh_1) and not na(last_sh_2) and last_sh_1 < last_sh_2 and na(broken_bear_tl_at)
    bear_tl_x0 := last_sh_2_bar
    bear_tl_y0 := last_sh_2
    bear_tl_x1 := last_sh_1_bar
    bear_tl_y1 := last_sh_1

// Trendline break detection
brk_tol = tl_break_ticks * tick_sz
bull_tl_active = not na(bull_tl_x0) and na(broken_bull_tl_at)
bear_tl_active = not na(bear_tl_x0) and na(broken_bear_tl_at)

if bull_tl_active
    val = tl_value_at(bull_tl_x0, bull_tl_y0, bull_tl_x1, bull_tl_y1, bar_index)
    if close < val - brk_tol
        broken_bull_tl_at := bar_index
        bull_tl_active := false
if bear_tl_active
    val = tl_value_at(bear_tl_x0, bear_tl_y0, bear_tl_x1, bear_tl_y1, bar_index)
    if close > val + brk_tol
        broken_bear_tl_at := bar_index
        bear_tl_active := false

// Reset broken-flag when new lines form after the test window
if not na(broken_bull_tl_at) and bar_index - broken_bull_tl_at > tl_test_window
    broken_bull_tl_at := na
if not na(broken_bear_tl_at) and bar_index - broken_bear_tl_at > tl_test_window
    broken_bear_tl_at := na

// Draw trendlines
if draw_trendlines
    if bull_tl_active and barstate.islast
        if not na(bull_tl_line)
            line.delete(bull_tl_line)
        bull_tl_y_end = tl_value_at(bull_tl_x0, bull_tl_y0, bull_tl_x1, bull_tl_y1, bar_index + 5)
        bull_tl_line := line.new(bull_tl_x0, bull_tl_y0, bar_index + 5, bull_tl_y_end, color=color.lime, width=2, extend=extend.right)
    if bear_tl_active and barstate.islast
        if not na(bear_tl_line)
            line.delete(bear_tl_line)
        bear_tl_y_end = tl_value_at(bear_tl_x0, bear_tl_y0, bear_tl_x1, bear_tl_y1, bar_index + 5)
        bear_tl_line := line.new(bear_tl_x0, bear_tl_y0, bar_index + 5, bear_tl_y_end, color=color.new(color.orange, 0), width=2, extend=extend.right)

trendline_in_play(bull) =>
    bull ? bull_tl_active : bear_tl_active

// ============================================================================
// Trend classification
// ============================================================================
var int above_count = 0
var int below_count = 0
above_count := 0
below_count := 0
for i = 0 to 19
    if close[i] > ema21[i]
        above_count := above_count + 1
    if close[i] < ema21[i]
        below_count := below_count + 1

hh_hl = not na(last_sh_1) and not na(last_sh_2) and not na(last_sl_1) and not na(last_sl_2) and last_sh_1 > last_sh_2 and last_sl_1 > last_sl_2
ll_lh = not na(last_sh_1) and not na(last_sh_2) and not na(last_sl_1) and not na(last_sl_2) and last_sh_1 < last_sh_2 and last_sl_1 < last_sl_2

bull_trend = above_count >= trend_bars_above_ema and hh_hl and bull_tl_active
bear_trend = below_count >= trend_bars_above_ema and ll_lh and bear_tl_active
trading_range = not bull_trend and not bear_trend

// ============================================================================
// Trading range
// ============================================================================
hi_n = ta.highest(high, range_lookback)
lo_n = ta.lowest(low,  range_lookback)
range_band = range_band_ticks * tick_sz
var bool range_active = false
var float range_top = na
var float range_bot = na
var box range_box = na

// rough swing-count near extremes (approx via pivot detection above)
near_top_1 = not na(last_sh_1) and math.abs(last_sh_1 - hi_n) <= range_band
near_top_2 = not na(last_sh_2) and math.abs(last_sh_2 - hi_n) <= range_band
near_bot_1 = not na(last_sl_1) and math.abs(last_sl_1 - lo_n) <= range_band
near_bot_2 = not na(last_sl_2) and math.abs(last_sl_2 - lo_n) <= range_band

if not range_active and near_top_1 and near_top_2 and near_bot_1 and near_bot_2 and not bull_trend and not bear_trend
    range_active := true
    range_top := hi_n
    range_bot := lo_n
    if draw_range_box
        if not na(range_box)
            box.delete(range_box)
        range_box := box.new(bar_index - range_lookback, range_top, bar_index, range_bot, border_color=color.new(color.aqua, 60), bgcolor=color.new(color.aqua, 92))

if range_active
    brk_t = range_break_ticks * tick_sz
    bool_break_up = true
    bool_break_dn = true
    for i = 0 to range_break_bars - 1
        if close[i] <= range_top + brk_t
            bool_break_up := false
        if close[i] >= range_bot - brk_t
            bool_break_dn := false
    if bool_break_up or bool_break_dn
        range_active := false
        if draw_range_box and not na(range_box)
            box.delete(range_box)
            range_box := na

// ============================================================================
// Signal bar validation
// ============================================================================
valid_signal_bar(barsAgo, isLong) =>
    o = open[barsAgo]
    h = high[barsAgo]
    l = low[barsAgo]
    c = close[barsAgo]
    r = h - l
    a = atrv[barsAgo]
    cond_atr = na(a) or a == 0 or r <= max_signal_range_atr * a
    cond_body = math.abs(c - o) >= min_body_fraction * r
    cond_bull = isLong  and c > o and ((c - l) / r) >= min_close_strength
    cond_bear = (not isLong) and c < o and ((h - c) / r) >= min_close_strength
    r > 0 and cond_atr and cond_body and (isLong ? cond_bull : cond_bear)

// ============================================================================
// KEP detection (current bar only)
// ============================================================================
at_kep(isLong) =>
    string kep = na
    count = 0
    if isLong
        if low <= ema21 + ema_proximity_ticks * tick_sz
            kep := "EMA"
            count := count + 1
        if bull_tl_active
            tlv = tl_value_at(bull_tl_x0, bull_tl_y0, bull_tl_x1, bull_tl_y1, bar_index)
            if low <= tlv + tl_pierce_ticks * tick_sz and close >= tlv - tl_pierce_ticks * tick_sz
                kep := count == 0 ? "TRENDLINE" : "CONFLUENCE"
                count := count + 1
    else
        if high >= ema21 - ema_proximity_ticks * tick_sz
            kep := "EMA"
            count := count + 1
        if bear_tl_active
            tlv = tl_value_at(bear_tl_x0, bear_tl_y0, bear_tl_x1, bear_tl_y1, bar_index)
            if high >= tlv - tl_pierce_ticks * tick_sz and close <= tlv + tl_pierce_ticks * tick_sz
                kep := count == 0 ? "TRENDLINE" : "CONFLUENCE"
                count := count + 1
    kep

// ============================================================================
// Pullback tracking
// ============================================================================
var bool  bull_pb_active = false
var int   bull_pb_start  = na
var float bull_pb_extreme_low = na
var bool  bull_pb_h1 = false
var bool  bull_pb_h2 = false
var float bull_pb_last_high = na

var bool  bear_pb_active = false
var int   bear_pb_start  = na
var float bear_pb_extreme_high = na
var bool  bear_pb_l1 = false
var bool  bear_pb_l2 = false
var float bear_pb_last_low = na

if not bull_trend
    bull_pb_active := false
if not bear_trend
    bear_pb_active := false

if bull_trend
    if not bull_pb_active
        if high <= high[1] and close < high[1]
            bull_pb_active := true
            bull_pb_start := bar_index
            bull_pb_extreme_low := low
            bull_pb_h1 := false
            bull_pb_h2 := false
            bull_pb_last_high := high
    else
        if low < bull_pb_extreme_low
            bull_pb_extreme_low := low
            bull_pb_h1 := false
        if not bull_pb_h1
            if high > high[1] and bar_index - bull_pb_start >= 1
                bull_pb_h1 := true
                bull_pb_last_high := high
        else
            if high > high[1] and high[1] < bull_pb_last_high
                bull_pb_h2 := true
        if bar_index - bull_pb_start > max_pullback_bars
            bull_pb_active := false

if bear_trend
    if not bear_pb_active
        if low >= low[1] and close > low[1]
            bear_pb_active := true
            bear_pb_start := bar_index
            bear_pb_extreme_high := high
            bear_pb_l1 := false
            bear_pb_l2 := false
            bear_pb_last_low := low
    else
        if high > bear_pb_extreme_high
            bear_pb_extreme_high := high
            bear_pb_l1 := false
        if not bear_pb_l1
            if low < low[1] and bar_index - bear_pb_start >= 1
                bear_pb_l1 := true
                bear_pb_last_low := low
        else
            if low < low[1] and low[1] > bear_pb_last_low
                bear_pb_l2 := true
        if bar_index - bear_pb_start > max_pullback_bars
            bear_pb_active := false

// ============================================================================
// Regime gates (spec sec 7.5, 13.5)
// ============================================================================

// Congestion: tight range + low drift + no pivots in window
hi_cong = ta.highest(high, congestion_lookback)
lo_cong = ta.lowest(low,  congestion_lookback)
range_tight   = (hi_cong - lo_cong) <= congestion_max_range * tick_sz
drift_small   = math.abs(close - close[congestion_lookback]) <= congestion_max_drift * tick_sz
pivot_in_win  = (not na(last_sh_1_bar) and bar_index - last_sh_1_bar <= congestion_lookback) or (not na(last_sl_1_bar) and bar_index - last_sl_1_bar <= congestion_lookback)
in_congestion = enable_congestion and range_tight and drift_small and not pivot_in_win

// New-extreme cooldown
var int last_new_extreme_long = -10000
var int last_new_extreme_short = -10000
var float last_sh_seen = na
var float last_sl_seen = na
ne_thr = new_extreme_min_ticks * tick_sz
if not na(ph)
    if na(last_sh_seen) or ph > last_sh_seen + ne_thr
        last_sh_seen := ph
        last_new_extreme_long := bar_index - swing_strength
if not na(pl)
    if na(last_sl_seen) or pl < last_sl_seen - ne_thr
        last_sl_seen := pl
        last_new_extreme_short := bar_index - swing_strength

new_extreme_block_long  = (bar_index - last_new_extreme_long)  < new_extreme_cooldown
new_extreme_block_short = (bar_index - last_new_extreme_short) < new_extreme_cooldown

// Mid-range filter
mid_block_long  = range_active and (close - range_bot) / (range_top - range_bot) > mid_range_high_frac
mid_block_short = range_active and (close - range_bot) / (range_top - range_bot) < mid_range_low_frac

// Pullback depth filter
pb_depth_ok(isLong) =>
    ok = true
    if isLong and not na(last_sh_1) and not na(last_sl_1) and last_sl_1_bar < last_sh_1_bar
        leg = last_sh_1 - last_sl_1
        if leg > 0 and not na(bull_pb_extreme_low)
            depth = last_sh_1 - bull_pb_extreme_low
            ok := (depth / leg) >= min_pullback_depth_frac
    if not isLong and not na(last_sh_1) and not na(last_sl_1) and last_sh_1_bar < last_sl_1_bar
        leg = last_sh_1 - last_sl_1
        if leg > 0 and not na(bear_pb_extreme_high)
            depth = bear_pb_extreme_high - last_sl_1
            ok := (depth / leg) >= min_pullback_depth_frac
    ok

// ============================================================================
// Risk + session
// ============================================================================
var int session_day = na
var float daily_loss_r = 0
var int cooldown_until_bar = -1

day_now = dayofmonth(time, "America/New_York")
if na(session_day) or day_now != session_day
    session_day := day_now
    daily_loss_r := 0

// max_daily_trades is enforced via strategy.risk.max_intraday_filled_orders below
in_session = (not rth_only) or is_rth_bar()
gates_ok = in_session and not in_congestion and daily_loss_r < max_daily_loss_r and bar_index >= cooldown_until_bar and strategy.position_size == 0

strategy.risk.max_intraday_filled_orders(max_daily_trades)

// ============================================================================
// Stop / Target compute
// ============================================================================
compute_stop(isLong, entry) =>
    float s = na
    if stop_mode == "BEYOND_SIGNAL_BAR"
        s := isLong ? low - tick_sz : high + tick_sz
    else if stop_mode == "FIXED_POINTS"
        s := isLong ? entry - stop_points : entry + stop_points
    else if stop_mode == "FIXED_TICKS"
        off = stop_ticks * tick_sz
        s := isLong ? entry - off : entry + off
    else if stop_mode == "ATR"
        s := isLong ? entry - stop_atr_mult * atrv : entry + stop_atr_mult * atrv
    else if stop_mode == "BEYOND_SWING"
        s := isLong ? (na(last_sl_1) ? low - tick_sz : last_sl_1 - tick_sz) : (na(last_sh_1) ? high + tick_sz : last_sh_1 + tick_sz)
    s

compute_target(isLong, entry, stop) =>
    r = math.abs(entry - stop)
    float t = na
    if target_mode == "FIXED_POINTS"
        t := isLong ? entry + target_points : entry - target_points
    else if target_mode == "FIXED_TICKS"
        off = target_ticks * tick_sz
        t := isLong ? entry + off : entry - off
    else if target_mode == "R_MULTIPLE"
        t := isLong ? entry + target_r * r : entry - target_r * r
    else if target_mode == "ATR"
        t := isLong ? entry + target_atr_mult * atrv : entry - target_atr_mult * atrv
    else if target_mode == "MEASURED_MOVE"
        if not na(last_sh_1) and not na(last_sl_1)
            leg = math.abs(last_sh_1 - last_sl_1)
            t := isLong ? entry + leg : entry - leg
        else
            t := isLong ? entry + 2 * r : entry - 2 * r
    else if target_mode == "OPPOSITE_KEP"
        if range_active
            t := isLong ? range_top : range_bot
        else
            t := isLong ? entry + 2 * r : entry - 2 * r
    t

// ============================================================================
// Signal generation
// ============================================================================
// trigger_long / trigger_short return true if the order was issued.
// Globals daily_trade_count / draw_signal_markers labels are mutated AT THE CALL SITE.
trigger_long(setup, kep_) =>
    entry  = high + tick_sz
    stop   = compute_stop(true, entry)
    target = compute_target(true, entry, stop)
    risk   = entry - stop
    rr_ok  = risk > 0 and (target - entry) / risk >= min_rr_to_enter
    fired = false
    if gates_ok and allow_longs and rr_ok and not na(kep_)
        strategy.entry(setup, strategy.long, stop = entry, comment = setup + ":" + kep_)
        strategy.exit(setup + "_X", from_entry = setup, stop = stop, limit = target)
        fired := true
    fired

trigger_short(setup, kep_) =>
    entry  = low - tick_sz
    stop   = compute_stop(false, entry)
    target = compute_target(false, entry, stop)
    risk   = stop - entry
    rr_ok  = risk > 0 and (entry - target) / risk >= min_rr_to_enter
    fired = false
    if gates_ok and allow_shorts and rr_ok and not na(kep_)
        strategy.entry(setup, strategy.short, stop = entry, comment = setup + ":" + kep_)
        strategy.exit(setup + "_X", from_entry = setup, stop = stop, limit = target)
        fired := true
    fired

// (Use trigger_long / trigger_short directly at top-level call sites; the call site
//  is responsible for incrementing daily_trade_count and drawing labels.)

// ---- 2EL / 2ES ----
if enable_2el_2es and bull_trend and bull_pb_active and bull_pb_h2 and (high - bull_pb_extreme_low) >= min_pullback_ticks * tick_sz and pb_depth_ok(true) and not new_extreme_block_long and not mid_block_long
    kep = at_kep(true)
    if not na(kep) and valid_signal_bar(0, true)
        if trigger_long("2EL", kep)
            bull_pb_active := false

if enable_2el_2es and bear_trend and bear_pb_active and bear_pb_l2 and (bear_pb_extreme_high - low) >= min_pullback_ticks * tick_sz and pb_depth_ok(false) and not new_extreme_block_short and not mid_block_short
    kep = at_kep(false)
    if not na(kep) and valid_signal_bar(0, false)
        if trigger_short("2ES", kep)
            bear_pb_active := false

// ---- F2EL / F2ES ----
if enable_f2el_f2es and bull_trend and trendline_in_play(true) and not new_extreme_block_long and not mid_block_long
    for k = 1 to f2e_reversal_bars + 1
        if valid_signal_bar(k, false)
            broke_low = false
            trig = low[k] - tick_sz
            // ascending iteration over bars between the prior signal and now
            for m = 0 to k - 1
                if low[m] < trig
                    broke_low := true
            if not broke_low
                kep = at_kep(true)
                if not na(kep) and valid_signal_bar(0, true)
                    if trigger_long("F2EL", kep)
                        break

if enable_f2el_f2es and bear_trend and trendline_in_play(false) and not new_extreme_block_short and not mid_block_short
    for k = 1 to f2e_reversal_bars + 1
        if valid_signal_bar(k, true)
            broke_high = false
            trig = high[k] + tick_sz
            for m = 0 to k - 1
                if high[m] > trig
                    broke_high := true
            if not broke_high
                kep = at_kep(false)
                if not na(kep) and valid_signal_bar(0, false)
                    if trigger_short("F2ES", kep)
                        break

// ---- Failed Breakout ----
var int   fb_armed_long_bar  = -1
var float fb_armed_long_exc  = na
var int   fb_armed_short_bar = -1
var float fb_armed_short_exc = na

if enable_failed_breakout and range_active
    lo_ex = ta.lowest(low, fail_breakout_window)
    hi_ex = ta.highest(high, fail_breakout_window)
    if fb_require_pb_confirm
        if lo_ex < range_bot and (range_bot - lo_ex) <= fail_breakout_max_ticks * tick_sz and close > range_bot
            fb_armed_long_bar := bar_index
            fb_armed_long_exc := lo_ex
        if hi_ex > range_top and (hi_ex - range_top) <= fail_breakout_max_ticks * tick_sz and close < range_top
            fb_armed_short_bar := bar_index
            fb_armed_short_exc := hi_ex
        if fb_armed_long_bar >= 0
            if bar_index - fb_armed_long_bar > fb_pullback_window
                fb_armed_long_bar := -1
            else if bar_index > fb_armed_long_bar and low > fb_armed_long_exc + fb_lh_hl_min_ticks * tick_sz and low > low[1] and valid_signal_bar(0, true)
                if trigger_long("FB_PB_LONG", "RANGE_EDGE")
                    fb_armed_long_bar := -1
        if fb_armed_short_bar >= 0
            if bar_index - fb_armed_short_bar > fb_pullback_window
                fb_armed_short_bar := -1
            else if bar_index > fb_armed_short_bar and high < fb_armed_short_exc - fb_lh_hl_min_ticks * tick_sz and high < high[1] and valid_signal_bar(0, false)
                if trigger_short("FB_PB_SHORT", "RANGE_EDGE")
                    fb_armed_short_bar := -1
    else
        if lo_ex < range_bot and (range_bot - lo_ex) <= fail_breakout_max_ticks * tick_sz and close > range_bot and valid_signal_bar(0, true)
            trigger_long("FB_LONG", "RANGE_EDGE")
        if hi_ex > range_top and (hi_ex - range_top) <= fail_breakout_max_ticks * tick_sz and close < range_top and valid_signal_bar(0, false)
            trigger_short("FB_SHORT", "RANGE_EDGE")

// ---- HL / LH reversal ----
if enable_hl_lh and not na(broken_bear_tl_at) and bar_index - broken_bear_tl_at < tl_test_window and not na(last_sl_1) and not na(last_sl_2) and last_sl_1 > last_sl_2 and last_sl_1_bar > broken_bear_tl_at and valid_signal_bar(0, true)
    trigger_long("HLLH_LONG", "SR")
if enable_hl_lh and not na(broken_bull_tl_at) and bar_index - broken_bull_tl_at < tl_test_window and not na(last_sh_1) and not na(last_sh_2) and last_sh_1 < last_sh_2 and last_sh_1_bar > broken_bull_tl_at and valid_signal_bar(0, false)
    trigger_short("HLLH_SHORT", "SR")

// ============================================================================
// Trade close -> loss tracking
// ============================================================================
if strategy.closedtrades > strategy.closedtrades[1]
    t_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if t_pnl < 0
        // Approximate R using the StopPoints in $ terms when configured, else 4 pts
        approx_risk = stop_mode == "FIXED_POINTS" ? stop_points : 4.0
        daily_loss_r := daily_loss_r + math.abs(t_pnl) / (approx_risk * syminfo.pointvalue)
        cooldown_until_bar := bar_index + cooldown_bars_after_loss

// ============================================================================
// Alerts
// ============================================================================
alertcondition(strategy.position_size > 0 and strategy.position_size[1] <= 0, title="ES PA long entry", message="ES Price Action long entered")
alertcondition(strategy.position_size < 0 and strategy.position_size[1] >= 0, title="ES PA short entry", message="ES Price Action short entered")
