//@version=5
// ES PA Pivots - Brooks-style pivot + trend-state indicator
// ============================================================================
// Standalone visual-only indicator. Mirrors python/channels_yahoo_test.py:
//   1. Williams fractal at strength N (default 2) + strict H/L alternation
//      (collapse same-kind runs to the more extreme pivot).
//   2. Trend-state state machine on the alternated stream:
//      UNK / UP / DOWN / PEND_UP / PEND_DOWN
//      - UP -> DOWN: needs LL that breaks the prior HL by >= min_break_atr*ATR,
//        AND a confirming LH.
//      - DOWN -> UP: needs HH breaking prior LH by same threshold, AND HL.
//      - On confirmation, trend extreme is retroactively marked BLACK.
//   3. Display (Mouli's strict convention):
//      UP   + HL (low)    | GREEN  arrow up   | trend-continuation pullback
//      UP   + LL (low)    | GRAY   arrow up   | structural-break warning
//                                              (weak if break < threshold,
//                                               strong if >= threshold)
//      UP   + any high    | HIDDEN            | upper pivots not shown in UP
//      DOWN + LH (high)   | RED    arrow down | trend-continuation rally
//      DOWN + HH (high)   | GRAY   arrow down | structural-break warning
//      DOWN + any low     | HIDDEN            | lower pivots not shown in DOWN
//      UNK / pending      | mostly HIDDEN     | confirming pivots draw GREEN/RED
//      trend extreme      | BLACK vertical    | retroactive trend-switch marker
//   4. Weak vs strong gray:
//      - STRONG: break of prior structural level >= min_break_atr * ATR.
//        Triggers state transition to PEND. Drawn in color.gray, size.small.
//      - WEAK: 0 < break < min_break_atr * ATR. Stays in current trend.
//        Drawn in color.silver, size.tiny.
//
// Validation: /ES 2m 5/29 RTH -> 5 BLACK at ~10:00 / 10:44 / 12:40 / 14:00 / 15:42
// ============================================================================

indicator("ES PA Pivots", overlay=true, max_lines_count=500)

// Inputs ---------------------------------------------------------------------
strength      = input.int(2,   "Pivot strength (bars each side)", minval=1, maxval=10, group="Pivot")
min_break_atr = input.float(0.5, "Reversal break (xATR)", minval=0.0, maxval=3.0, step=0.05, tooltip="LL must undercut prior HL (or HH overshoot prior LH) by this many ATRs to flip the trend. Below threshold = weak break.", group="Trend state")
show_black    = input.bool(true,  "Show BLACK trend-switch markers", group="Display")
show_green    = input.bool(true,  "Show GREEN HL lows in UP",        group="Display")
show_red      = input.bool(true,  "Show RED LH highs in DOWN",       group="Display")
show_gray_strong = input.bool(true, "Show STRONG gray warnings (LL in UP / HH in DOWN, break >= threshold)", group="Display")
show_gray_weak   = input.bool(true, "Show WEAK gray warnings (break < threshold, still in range)", group="Display")
show_ema      = input.bool(true,  "Show EMA21", group="Display")
ema_length    = input.int(21, "EMA length", minval=5, maxval=200, group="Display")
black_marker_height_atr = input.float(0.4, "BLACK marker height (xATR)", minval=0.05, maxval=2.0, step=0.05, group="Display")
black_marker_width = input.int(3, "BLACK marker line width", minval=1, maxval=8, group="Display")

// ATR + EMA -----------------------------------------------------------------
atr14 = ta.atr(14)
ema21 = ta.ema(close, ema_length)
plot(show_ema ? ema21 : na, "EMA", color=color.blue, linewidth=1)

// Fractal candidates --------------------------------------------------------
ph_cand = ta.pivothigh(high, strength, strength)
pl_cand = ta.pivotlow(low,  strength, strength)
new_ph = not na(ph_cand)
new_pl = not na(pl_cand)

// Alternated pivot stream ---------------------------------------------------
var array<float> piv_p = array.new<float>(0)
var array<int>   piv_b = array.new<int>(0)
var array<int>   piv_t = array.new<int>(0)

// Trend state ---------------------------------------------------------------
// 0=UNK, 1=UP, 2=DOWN, 3=PEND_UP, 4=PEND_DOWN
var int   tstate       = 0
var float last_h_price = na
var float last_l_price = na
var float extreme_h_p  = na
var int   extreme_h_i  = na
var float extreme_l_p  = na
var int   extreme_l_i  = na
var float last_HL_p    = na
var float last_LH_p    = na

// Per-bar plotshape flags
bool flag_green_l         = false  // HL during UP (continuation)
bool flag_red_h           = false  // LH during DOWN (continuation)
bool flag_warn_l_strong   = false  // LL during UP with strong break
bool flag_warn_l_weak     = false  // LL during UP with weak break (in range)
bool flag_warn_h_strong   = false  // HH during DOWN with strong break
bool flag_warn_h_weak     = false  // HH during DOWN with weak break

// Push a new pivot or replace the last same-kind extreme
push_alt(p, b, kind) =>
    n = array.size(piv_t)
    out_idx = -1
    if n == 0
        array.push(piv_p, p)
        array.push(piv_b, b)
        array.push(piv_t, kind)
        out_idx := array.size(piv_t) - 1
    else
        last_kind = array.last(piv_t)
        if last_kind == kind
            last_p = array.last(piv_p)
            replace = (kind == 1 and p > last_p) or (kind == -1 and p < last_p)
            if replace
                last_i = array.size(piv_p) - 1
                array.set(piv_p, last_i, p)
                array.set(piv_b, last_i, b)
                out_idx := last_i
        else
            array.push(piv_p, p)
            array.push(piv_b, b)
            array.push(piv_t, kind)
            out_idx := array.size(piv_t) - 1
    out_idx

// Draw BLACK vertical line at a past pivot
draw_black(arr_idx, kind) =>
    if arr_idx >= 0
        if arr_idx < array.size(piv_b)
            bx = array.get(piv_b, arr_idx)
            bp = array.get(piv_p, arr_idx)
            ah = na(atr14) ? 1.0 : atr14 * black_marker_height_atr
            y_top    = kind == 1 ? bp + ah : bp
            y_bottom = kind == 1 ? bp      : bp - ah
            if show_black
                line.new(bx, y_bottom, bx, y_top, color=color.black, width=black_marker_width, style=line.style_solid)

// === On new HIGH pivot =====================================================
if new_ph
    state_pre_h = tstate
    last_LH_before = last_LH_p  // snapshot BEFORE we possibly overwrite
    piv_bar_h = bar_index - strength
    idx_h = push_alt(ph_cand, piv_bar_h, 1)
    if idx_h >= 0
        struct_h = na(last_h_price) ? "UNK" : (ph_cand > last_h_price ? "HH" : "LH")
        if na(extreme_h_p)
            extreme_h_p := ph_cand
            extreme_h_i := idx_h
        else if ph_cand > extreme_h_p
            extreme_h_p := ph_cand
            extreme_h_i := idx_h
        last_h_price := ph_cand
        if struct_h == "LH"
            last_LH_p := ph_cand
        thr_h = na(atr14) ? 0.0 : atr14 * min_break_atr
        // State transitions
        if tstate == 2 and struct_h == "HH"
            strong_up = na(last_LH_before) or (ph_cand - last_LH_before) >= thr_h
            if strong_up
                tstate := 3
        else if tstate == 4 and struct_h == "LH"
            if not na(extreme_h_i)
                if extreme_h_i != idx_h
                    draw_black(extreme_h_i, 1)
            tstate := 2
            extreme_h_p := na
            extreme_h_i := na
            last_HL_p := na
            last_LH_p := ph_cand
        else if tstate == 3 and struct_h == "LH"
            tstate := 2
        else if tstate == 0 and struct_h == "HH"
            tstate := 1
        state_post_h = tstate
        // Color decision per Mouli's rule
        // 1) Warning: pre-state was DOWN and a new HH appeared
        if state_pre_h == 2 and struct_h == "HH"
            break_dist = na(last_LH_before) ? 1.0e9 : (ph_cand - last_LH_before)
            if break_dist >= thr_h
                flag_warn_h_strong := true
            else
                flag_warn_h_weak := true
        // 2) Continuation: post-state DOWN and struct LH (incl. confirming LH from PEND_DOWN)
        else if state_post_h == 2 and struct_h == "LH"
            flag_red_h := true
        // else: hidden

// === On new LOW pivot ======================================================
if new_pl
    state_pre_l = tstate
    last_HL_before = last_HL_p
    piv_bar_l = bar_index - strength
    idx_l = push_alt(pl_cand, piv_bar_l, -1)
    if idx_l >= 0
        struct_l = na(last_l_price) ? "UNK" : (pl_cand < last_l_price ? "LL" : "HL")
        if na(extreme_l_p)
            extreme_l_p := pl_cand
            extreme_l_i := idx_l
        else if pl_cand < extreme_l_p
            extreme_l_p := pl_cand
            extreme_l_i := idx_l
        last_l_price := pl_cand
        if struct_l == "HL"
            last_HL_p := pl_cand
        thr_l = na(atr14) ? 0.0 : atr14 * min_break_atr
        if tstate == 1 and struct_l == "LL"
            strong_dn = na(last_HL_before) or (last_HL_before - pl_cand) >= thr_l
            if strong_dn
                tstate := 4
        else if tstate == 3 and struct_l == "HL"
            if not na(extreme_l_i)
                if extreme_l_i != idx_l
                    draw_black(extreme_l_i, -1)
            tstate := 1
            extreme_l_p := na
            extreme_l_i := na
            last_LH_p := na
            last_HL_p := pl_cand
        else if tstate == 4 and struct_l == "HL"
            tstate := 1
        else if tstate == 0 and struct_l == "LL"
            tstate := 2
        state_post_l = tstate
        // Color decision
        // 1) Warning: pre-state was UP and a new LL appeared
        if state_pre_l == 1 and struct_l == "LL"
            break_dist = na(last_HL_before) ? 1.0e9 : (last_HL_before - pl_cand)
            if break_dist >= thr_l
                flag_warn_l_strong := true
            else
                flag_warn_l_weak := true
        // 2) Continuation: post-state UP and struct HL
        else if state_post_l == 1 and struct_l == "HL"
            flag_green_l := true
        // else: hidden

// === plotshape outputs =====================================================
src_green_l        = flag_green_l       and show_green       ? pl_cand : na
src_red_h          = flag_red_h         and show_red         ? ph_cand : na
src_warn_h_strong  = flag_warn_h_strong and show_gray_strong ? ph_cand : na
src_warn_h_weak    = flag_warn_h_weak   and show_gray_weak   ? ph_cand : na
src_warn_l_strong  = flag_warn_l_strong and show_gray_strong ? pl_cand : na
src_warn_l_weak    = flag_warn_l_weak   and show_gray_weak   ? pl_cand : na

plotshape(src_green_l,       "GREEN low (HL in UP)",    style=shape.arrowup,   location=location.absolute, color=color.green,  size=size.normal, offset=-strength)
plotshape(src_red_h,         "RED high (LH in DOWN)",   style=shape.arrowdown, location=location.absolute, color=color.red,    size=size.normal, offset=-strength)
plotshape(src_warn_h_strong, "GRAY strong (HH in DOWN, broke LH)", style=shape.arrowdown, location=location.absolute, color=color.gray,   size=size.small, offset=-strength)
plotshape(src_warn_h_weak,   "GRAY weak (HH in DOWN, in range)",   style=shape.arrowdown, location=location.absolute, color=color.silver, size=size.tiny,  offset=-strength)
plotshape(src_warn_l_strong, "GRAY strong (LL in UP, broke HL)",   style=shape.arrowup,   location=location.absolute, color=color.gray,   size=size.small, offset=-strength)
plotshape(src_warn_l_weak,   "GRAY weak (LL in UP, in range)",     style=shape.arrowup,   location=location.absolute, color=color.silver, size=size.tiny,  offset=-strength)

// === Status table (viewport-anchored) ======================================
var table status_tbl = table.new(position.top_right, 2, 2, bgcolor=color.new(color.gray, 80), border_width=1)
if barstate.islast
    state_s = tstate == 0 ? "UNK" : (tstate == 1 ? "UP" : (tstate == 2 ? "DOWN" : (tstate == 3 ? "PEND_UP" : "PEND_DOWN")))
    table.cell(status_tbl, 0, 0, "Trend",  text_color=color.black, text_size=size.normal)
    table.cell(status_tbl, 1, 0, state_s,  text_color=color.black, text_size=size.normal)
    table.cell(status_tbl, 0, 1, "Pivots", text_color=color.black, text_size=size.small)
    table.cell(status_tbl, 1, 1, str.tostring(array.size(piv_t)), text_color=color.black, text_size=size.small)
