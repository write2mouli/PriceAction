//@version=5
// ES PA Pivots - Brooks-style pivot + trend-state indicator
// ============================================================================
// Standalone visual-only indicator. Mirrors python/channels_yahoo_test.py:
//   1. Williams fractal at strength N (default 2) + strict H/L alternation
//      (collapse same-kind runs to the more extreme pivot).
//   2. Trend-state state machine on the alternated stream:
//      UNK / UP / DOWN / PEND_UP / PEND_DOWN
//      - UP -> DOWN: needs LL that breaks the prior HL by >= min_break_atr*ATR,
//        AND a confirming LH.
//      - DOWN -> UP: needs HH breaking prior LH by same threshold, AND HL.
//      - On confirmation, trend extreme is retroactively marked BLACK.
//   3. Display:
//      - plotshape arrows for GREEN (uptrend lows) and RED (downtrend highs)
//        -- these auto-anchor to bars via Pine's pipeline
//      - line.new vertical bars for BLACK trend-switch markers (also bar-
//        anchored; replaces labels which had reports of not panning with
//        the chart)
//
// Validation: /ES 2m 5/29 RTH -> 5 BLACK at ~10:00 / 10:44 / 12:40 / 14:00 / 15:42
// ============================================================================

indicator("ES PA Pivots", overlay=true, max_lines_count=500)

// Inputs ---------------------------------------------------------------------
strength      = input.int(2,   "Pivot strength (bars each side)", minval=1, maxval=10, group="Pivot")
min_break_atr = input.float(0.5, "Reversal break (xATR)", minval=0.0, maxval=3.0, step=0.05, tooltip="LL must undercut prior HL (or HH overshoot prior LH) by this many ATRs to trigger reversal. 0 = any structural break.", group="Trend state")
show_black    = input.bool(true,  "Show BLACK trend-switch markers",   group="Display")
show_green    = input.bool(true,  "Show GREEN HL/HH lows in uptrend",  group="Display")
show_red      = input.bool(true,  "Show RED LH/LL highs in downtrend", group="Display")
show_ema      = input.bool(true,  "Show EMA21", group="Display")
ema_length    = input.int(21, "EMA length", minval=5, maxval=200, group="Display")
black_marker_height_atr = input.float(0.4, "BLACK marker height (xATR)", minval=0.05, maxval=2.0, step=0.05, group="Display")

// ATR + EMA -----------------------------------------------------------------
atr14 = ta.atr(14)
ema21 = ta.ema(close, ema_length)
plot(show_ema ? ema21 : na, "EMA", color=color.blue, linewidth=1)

// Fractal candidates --------------------------------------------------------
ph_cand = ta.pivothigh(high, strength, strength)
pl_cand = ta.pivotlow(low,  strength, strength)
new_ph = not na(ph_cand)
new_pl = not na(pl_cand)

// Alternated pivot stream ---------------------------------------------------
// Each pivot recorded as price + bar index + kind (1=H, -1=L). No labels --
// drawing is done by plotshape (per-bar arrows) + line.new (BLACK markers).
var array<float> piv_p   = array.new<float>(0)
var array<int>   piv_b   = array.new<int>(0)
var array<int>   piv_t   = array.new<int>(0)

// Trend state ---------------------------------------------------------------
// 0=UNK, 1=UP, 2=DOWN, 3=PEND_UP, 4=PEND_DOWN
var int   tstate       = 0
var float last_h_price = na
var float last_l_price = na
var float extreme_h_p  = na
var int   extreme_h_i  = na
var float extreme_l_p  = na
var int   extreme_l_i  = na
var float last_HL_p    = na
var float last_LH_p    = na

// Per-bar plotshape flags. Series bool resets to false each bar by default.
bool this_bar_green = false
bool this_bar_red   = false

// Push a new pivot or replace the last same-kind extreme. Returns array idx
// or -1 if push was skipped. Pure data; no drawing.
push_alt(p, b, kind) =>
    n = array.size(piv_t)
    out_idx = -1
    if n == 0
        array.push(piv_p, p)
        array.push(piv_b, b)
        array.push(piv_t, kind)
        out_idx := array.size(piv_t) - 1
    else
        last_kind = array.last(piv_t)
        if last_kind == kind
            last_p = array.last(piv_p)
            replace = (kind == 1 and p > last_p) or (kind == -1 and p < last_p)
            if replace
                last_i = array.size(piv_p) - 1
                array.set(piv_p, last_i, p)
                array.set(piv_b, last_i, b)
                out_idx := last_i
        else
            array.push(piv_p, p)
            array.push(piv_b, b)
            array.push(piv_t, kind)
            out_idx := array.size(piv_t) - 1
    out_idx

// Draw a BLACK marker (vertical line) at a past pivot bar
draw_black(arr_idx, kind) =>
    if arr_idx >= 0
        if arr_idx < array.size(piv_b)
            bx = array.get(piv_b, arr_idx)
            bp = array.get(piv_p, arr_idx)
            ah = na(atr14) ? 1.0 : atr14 * black_marker_height_atr
            y_top    = kind == 1 ? bp + ah : bp
            y_bottom = kind == 1 ? bp      : bp - ah
            if show_black
                line.new(bx, y_bottom, bx, y_top, color=color.black, width=3, style=line.style_solid)

// === On new HIGH pivot =====================================================
if new_ph
    piv_bar_h = bar_index - strength
    idx_h = push_alt(ph_cand, piv_bar_h, 1)
    if idx_h >= 0
        struct_h = na(last_h_price) ? "UNK" : (ph_cand > last_h_price ? "HH" : "LH")
        if na(extreme_h_p)
            extreme_h_p := ph_cand
            extreme_h_i := idx_h
        else if ph_cand > extreme_h_p
            extreme_h_p := ph_cand
            extreme_h_i := idx_h
        last_h_price := ph_cand
        if struct_h == "LH"
            last_LH_p := ph_cand
        thr_h = na(atr14) ? 0.0 : atr14 * min_break_atr
        // State transitions
        if tstate == 2 and struct_h == "HH"
            strong_up = na(last_LH_p) or (ph_cand - last_LH_p) >= thr_h
            if strong_up
                tstate := 3
        else if tstate == 4 and struct_h == "LH"
            if not na(extreme_h_i)
                if extreme_h_i != idx_h
                    draw_black(extreme_h_i, 1)
            tstate := 2
            extreme_h_p := na
            extreme_h_i := na
            last_HL_p := na
            last_LH_p := ph_cand
        else if tstate == 3 and struct_h == "LH"
            tstate := 2
        else if tstate == 0 and struct_h == "HH"
            tstate := 1
        // RED arrow if the trend state is DOWN AFTER processing this pivot's
        // transitions. Covers normal LH/LL during DOWN, the confirming LH
        // that flips PEND_DOWN to DOWN, and the fallback LH that returns
        // PEND_UP to DOWN. HH during DOWN that flips to PEND_UP is NOT red
        // (it's a breakout signal, not a downtrend continuation).
        if tstate == 2
            this_bar_red := true

// === On new LOW pivot ======================================================
if new_pl
    piv_bar_l = bar_index - strength
    idx_l = push_alt(pl_cand, piv_bar_l, -1)
    if idx_l >= 0
        struct_l = na(last_l_price) ? "UNK" : (pl_cand < last_l_price ? "LL" : "HL")
        if na(extreme_l_p)
            extreme_l_p := pl_cand
            extreme_l_i := idx_l
        else if pl_cand < extreme_l_p
            extreme_l_p := pl_cand
            extreme_l_i := idx_l
        last_l_price := pl_cand
        if struct_l == "HL"
            last_HL_p := pl_cand
        thr_l = na(atr14) ? 0.0 : atr14 * min_break_atr
        if tstate == 1 and struct_l == "LL"
            strong_dn = na(last_HL_p) or (last_HL_p - pl_cand) >= thr_l
            if strong_dn
                tstate := 4
        else if tstate == 3 and struct_l == "HL"
            if not na(extreme_l_i)
                if extreme_l_i != idx_l
                    draw_black(extreme_l_i, -1)
            tstate := 1
            extreme_l_p := na
            extreme_l_i := na
            last_LH_p := na
            last_HL_p := pl_cand
        else if tstate == 4 and struct_l == "HL"
            tstate := 1
        else if tstate == 0 and struct_l == "LL"
            tstate := 2
        // GREEN arrow if state is UP after processing
        if tstate == 1
            this_bar_green := true

// === plotshape: GREEN at lows during UP, RED at highs during DOWN ==========
// offset=-strength shifts the shape back to the actual pivot bar (the
// candidate fires `strength` bars after the pivot bar).
green_y = this_bar_green and show_green ? pl_cand : na
red_y   = this_bar_red   and show_red   ? ph_cand : na

plotshape(green_y, "GREEN low (uptrend)", style=shape.arrowup, location=location.absolute, color=color.green, size=size.small, offset=-strength)
plotshape(red_y,   "RED high (downtrend)", style=shape.arrowdown, location=location.absolute, color=color.red, size=size.small, offset=-strength)

// === Status table (viewport-anchored, doesn't move with chart pan) =========
var table status_tbl = table.new(position.top_right, 2, 2, bgcolor=color.new(color.gray, 80), border_width=1)
if barstate.islast
    state_s = tstate == 0 ? "UNK" : (tstate == 1 ? "UP" : (tstate == 2 ? "DOWN" : (tstate == 3 ? "PEND_UP" : "PEND_DOWN")))
    table.cell(status_tbl, 0, 0, "Trend",  text_color=color.black, text_size=size.normal)
    table.cell(status_tbl, 1, 0, state_s,  text_color=color.black, text_size=size.normal)
    table.cell(status_tbl, 0, 1, "Pivots", text_color=color.black, text_size=size.small)
    table.cell(status_tbl, 1, 1, str.tostring(array.size(piv_t)), text_color=color.black, text_size=size.small)
